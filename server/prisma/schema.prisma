  deductions     Float
  netPay         Float
  issuedAt       DateTime @default(now())
  fileName       String?
  fileMimeType   String?
  fileSize       Int?
  fileData       Bytes?
  uploadedById   String?
  uploadedBy     User?    @relation("PayslipUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  expense        Expense?

  createdAt DateTime @default(now())
}

enum SupplierStatus {
