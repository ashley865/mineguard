// ---------------------------------------------------------------------------
// Module: Mine Closure & Rehabilitation Financial Provision (MPRDA / NEMA)
// ---------------------------------------------------------------------------

enum RehabilitationStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  VERIFIED
}

// Every SA mine must maintain a costed, periodically-reassessed financial provision for
// eventual rehabilitation/closure and report progressive rehabilitation against an approved
