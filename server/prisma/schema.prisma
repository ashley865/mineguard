// ---------------------------------------------------------------------------

enum JobRequisitionStatus {
  DRAFT
  OPEN
  ON_HOLD
  FILLED
  CANCELLED
}

enum CandidateSource {
  REFERRAL
  AGENCY
  WALK_IN
  ONLINE_APPLICATION
  INTERNAL
  OTHER
}

enum CandidateStage {
  APPLIED
  SHORTLISTED
  INTERVIEWED
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

model JobRequisition {
  id                String               @id @default(cuid())
  siteId            String
  site              Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  positionTitle     String
  category          StaffCategory        @default(OTHER)
  numberOfPositions Int                  @default(1)
  justification     String?
  status            JobRequisitionStatus @default(DRAFT)
  targetFillDate    DateTime?
  requestedById     String?
  requestedBy       User?                @relation("RequisitionRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById      String?
  approvedBy        User?                @relation("RequisitionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt        DateTime?

  candidates Candidate[]

  createdAt DateTime @default(now())
}

// A candidate's resume is stored the same way as every other uploaded document in this
// app (Bytes in Postgres via multer) — no external file storage dependency.
model Candidate {
  id              String          @id @default(cuid())
  requisitionId   String
  requisition     JobRequisition  @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  fullName        String
  idNumber        String?
  email           String?
  phone           String?
  source          CandidateSource @default(OTHER)
  stage           CandidateStage  @default(APPLIED)
  appliedDate     DateTime        @default(now())
  interviewDate   DateTime?
  interviewNotes  String?
  offerAmount     Float?
  rejectionReason String?
  resumeFileName  String?
  resumeMimeType  String?
  resumeFileSize  Int?
  resumeFileData  Bytes?
  // Set only once a candidate is actually converted into a real Worker record via the
  // "hire" action — the single point where recruitment data becomes an employment record.
  hiredWorkerId   String?         @unique
  hiredWorker     Worker?         @relation(fields: [hiredWorkerId], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       User?           @relation("CandidateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// One per newly hired worker, created automatically when a candidate is converted to a
// Worker — fixed checklist fields (mirroring the EmployeeComplianceCheck pattern above)
// rather than a dynamic items table, since the onboarding steps are consistent across
// hires at a South African mine.
model OnboardingChecklist {
  id                      String    @id @default(cuid())
  workerId                String    @unique
  worker                  Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  inductionCompleted      Boolean   @default(false)
  inductionDate           DateTime?
  medicalCompleted        Boolean   @default(false)
  medicalDate             DateTime?
  ppeIssued               Boolean   @default(false)
  ppeIssuedDate           DateTime?
  contractSigned          Boolean   @default(false)
  contractSignedDate      DateTime?
  bankDetailsCollected    Boolean   @default(false)
  statutoryFormsCompleted Boolean   @default(false)
  systemAccessGranted     Boolean   @default(false)
  notes                   String?
  completedAt             DateTime?
  createdById             String?
  createdBy               User?     @relation("OnboardingChecklistCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Security Officer modules: Access Control & Gate Passes, Security
// Investigations, Key & Lock Management — real functional modules (not AI),
// complementing the existing CCTV/Incident/Patrol tabs on the Security Hub.
// ---------------------------------------------------------------------------

enum GatePassType {
  VISITOR
  CONTRACTOR
  EMPLOYEE_VEHICLE
  DELIVERY_VEHICLE
  EQUIPMENT_REMOVAL
  OTHER
}

enum GatePassStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

// A standing permit for recurring access (a contractor's vehicle for the duration of a
// job, a badge for a regular visitor) — distinct from GateLog, which is the actual
// entry/exit event record. Not every GateLog entry needs a pass (e.g. a one-off visitor).
model GatePass {
  id            String         @id @default(cuid())
  siteId        String
  site          Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  type          GatePassType   @default(VISITOR)
  holderName    String
  company       String?
  idNumber      String?
  vehicleReg    String?
  purpose       String?
  validFrom     DateTime       @default(now())
  validTo       DateTime?
  status        GatePassStatus @default(ACTIVE)
  revokedReason String?
  issuedById    String?
  issuedBy      User?          @relation("GatePassIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  logs          GateLog[]

  createdAt DateTime @default(now())
}

enum GateLogDirection {
  IN
  OUT
}

// The actual gate register: every entry/exit event, optionally tied to a standing
// GatePass. Checked against SecurityBlacklistEntry at creation time so a guard is warned
// immediately rather than the match only surfacing later during a review.
model GateLog {
  id           String            @id @default(cuid())
  siteId       String
  site         Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  gatePassId   String?
  gatePass     GatePass?         @relation(fields: [gatePassId], references: [id], onDelete: SetNull)
  direction    GateLogDirection
  personName   String
  company      String?
  vehicleReg   String?
  itemsCarried String?
  gateName     String?
  loggedAt     DateTime          @default(now())
  loggedById   String?
  loggedBy     User?             @relation("GateLogLoggedBy", fields: [loggedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// A person/vehicle barred from site access. Mine-wide (siteId null) or site-specific.
model SecurityBlacklistEntry {
  id         String   @id @default(cuid())
  siteId     String?
  site       Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name       String
  idNumber   String?
  vehicleReg String?
  reason     String
  isActive   Boolean  @default(true)
  addedById  String?
  addedBy    User?    @relation("BlacklistAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

enum InvestigationStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum InvestigationOutcome {
  SUBSTANTIATED
  UNSUBSTANTIATED
  INCONCLUSIVE
  REFERRED_EXTERNAL
}

// A formal case file for a serious security matter (theft, sabotage, fraud) — evidence
// log and witness statements, distinct from the quick SecurityIncident log which just
// captures the initial report. Optionally linked back to the SecurityIncident it grew
// out of, but can also be opened standalone (e.g. a proactive pattern investigation).
model SecurityInvestigation {
  id                 String                   @id @default(cuid())
  siteId             String
  site               Site                     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  securityIncidentId String?                  @unique
  securityIncident   SecurityIncident?        @relation(fields: [securityIncidentId], references: [id], onDelete: SetNull)
  title              String
  summary            String
  severity           AlertSeverity?
  status             InvestigationStatus      @default(OPEN)
  outcome            InvestigationOutcome?
  findings           String?
  leadInvestigatorId String?
  leadInvestigator   User?                    @relation("InvestigationLead", fields: [leadInvestigatorId], references: [id], onDelete: SetNull)
  openedAt           DateTime                 @default(now())
  closedAt           DateTime?
  createdById        String?
  createdBy          User?                    @relation("InvestigationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  evidenceItems       InvestigationEvidence[]
  statements          InvestigationStatement[]

  createdAt DateTime @default(now())
}

// Evidence is stored the same way as every other uploaded document in this app (Bytes
// in Postgres via multer) — no external file storage dependency.
model InvestigationEvidence {
  id              String                @id @default(cuid())
  investigationId String
  investigation   SecurityInvestigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  description     String
  fileName        String?
  fileMimeType    String?
  fileSize        Int?
  fileData        Bytes?
  collectedAt     DateTime              @default(now())
  addedById       String?
  addedBy         User?                 @relation("EvidenceAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model InvestigationStatement {
  id              String                @id @default(cuid())
  investigationId String
  investigation   SecurityInvestigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  witnessName     String
  role            String?
  statement       String
  statementDate   DateTime              @default(now())
  recordedById    String?
  recordedBy      User?                 @relation("StatementRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

enum SecurityKeyStatus {
  AVAILABLE
  ISSUED
  LOST
  RETIRED
}

// Register of keys/locks/safes. currentHolder (worker or ad-hoc name for a contractor
// not in the system) is denormalised onto the key itself for a simple "who has this
// right now" view, alongside the full history in KeyIssueLog.
model SecurityKey {
  id                String            @id @default(cuid())
  siteId            String
  site              Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  keyCode           String
  description       String
  location          String?
  status            SecurityKeyStatus @default(AVAILABLE)
  currentHolderName String?
  currentWorkerId   String?
  currentWorker     Worker?           @relation("SecurityKeyCurrentHolder", fields: [currentWorkerId], references: [id], onDelete: SetNull)
  createdById       String?
  createdBy         User?             @relation("SecurityKeyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  issueLogs         KeyIssueLog[]

  createdAt DateTime @default(now())

  @@unique([siteId, keyCode])
}

enum KeyIssueEventType {
  ISSUED
  RETURNED
  REPORTED_LOST
}

model KeyIssueLog {
  id           String            @id @default(cuid())
  keyId        String
  key          SecurityKey       @relation(fields: [keyId], references: [id], onDelete: Cascade)
  eventType    KeyIssueEventType
  holderName   String?
  workerId     String?
  worker       Worker?           @relation("KeyIssueLogWorker", fields: [workerId], references: [id], onDelete: SetNull)
  notes        String?
  eventAt      DateTime          @default(now())
  loggedById   String?
  loggedBy     User?             @relation("KeyIssueLogLoggedBy", fields: [loggedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

enum SecurityAssetType {
  RADIO
  BATON
  FIREARM
  ALARM_PANEL
  BARRIER
  METAL_DETECTOR
  BODY_CAMERA
  TORCH
  HANDCUFFS
  VEHICLE
  OTHER
}

enum SecurityAssetCondition {
  GOOD
  FAIR
  DAMAGED
  OUT_OF_SERVICE
}

enum SecurityAssetStatus {
  IN_STORE
  ASSIGNED
  IN_MAINTENANCE
  DECOMMISSIONED
}

// Security-specific equipment (radios, batons, firearms, alarm panels, barriers) —
// distinct from the general Equipment model, which covers heavy mining/fleet plant
// (excavators, haul trucks) rather than issued security gear. Mirrors the SecurityKey
// register/assignment-log shape: current assignment denormalised on the asset itself,
// full history in SecurityAssetAssignmentLog.
model SecurityAsset {
  id                 String                  @id @default(cuid())
  siteId             String
  site               Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assetTag           String
  type               SecurityAssetType       @default(OTHER)
  description        String
  serialNumber       String?
  condition          SecurityAssetCondition  @default(GOOD)
  status             SecurityAssetStatus     @default(IN_STORE)
  assignedWorkerId   String?
  assignedWorker     Worker?                 @relation("SecurityAssetAssignedWorker", fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  lastMaintenanceAt  DateTime?
  nextMaintenanceDue DateTime?
  notes              String?
  createdById        String?
  createdBy          User?                   @relation("SecurityAssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignmentLogs     SecurityAssetAssignmentLog[]

  createdAt DateTime @default(now())

  @@unique([siteId, assetTag])
}

enum SecurityAssetEventType {
  ASSIGNED
  RETURNED
  SENT_FOR_MAINTENANCE
  RETURNED_FROM_MAINTENANCE
  DECOMMISSIONED
}

model SecurityAssetAssignmentLog {
  id         String                  @id @default(cuid())
  assetId    String
  asset      SecurityAsset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  eventType  SecurityAssetEventType
  workerId   String?
  worker     Worker?                 @relation("SecurityAssetLogWorker", fields: [workerId], references: [id], onDelete: SetNull)
  notes      String?
  eventAt    DateTime                @default(now())
  loggedById String?
  loggedBy   User?                   @relation("SecurityAssetLogLoggedBy", fields: [loggedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Module: Shift Handover Log (Operations Manager)
// Continuity notes passed between outgoing and incoming shift supervisors —
// distinct from ShiftRoster (who is scheduled to work) and ProductionRecord
// (mineral output per shift): this is "what happened / what needs attention".
// ---------------------------------------------------------------------------

model ShiftHandover {
  id                 String        @id @default(cuid())
  siteId             String
  site               Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  shiftDate          DateTime
  shift              ProductionShift
  outgoingSupervisor String
  summary            String
  issues             String?
  actionItems        String?
  createdById        String?
  createdBy          User?         @relation("ShiftHandoverCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Module: Downtime & Delay Tracker (Operations Manager)
// Logs WHY and for how long equipment/processes were stopped — Equipment.status
// only holds a current DOWN flag, with no reason/duration history of its own.
// ---------------------------------------------------------------------------

enum DowntimeCategory {
  EQUIPMENT_BREAKDOWN
  POWER_OUTAGE
  WEATHER
  SAFETY_STOPPAGE
  MATERIAL_SHORTAGE
  LABOUR_SHORTAGE
  PLANNED_MAINTENANCE
  OTHER
}

model DowntimeEvent {
  id           String           @id @default(cuid())
  siteId       String
  site         Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  category     DowntimeCategory
  description  String
  affectedArea String?
  startedAt    DateTime
  endedAt      DateTime?
  createdById  String?
  createdBy    User?            @relation("DowntimeEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Module: IT Assets & Support Tickets (IT Manager)
// Mine-level (not site-scoped) since servers/network gear/licenses commonly
// aren't tied to a single site. IT Manager's first genuinely dedicated module.
// ---------------------------------------------------------------------------

enum ITAssetType {
  COMPUTER
  SERVER
  NETWORK_DEVICE
  MOBILE_DEVICE
  SOFTWARE_LICENSE
  PERIPHERAL
  OTHER
}

enum ITAssetStatus {
  ACTIVE
  IN_REPAIR
  RETIRED
  LOST
}

model ITAsset {
  id             String        @id @default(cuid())
  mineId         String
  mine           Mine          @relation(fields: [mineId], references: [id], onDelete: Cascade)
  assetTag       String
  name           String
  assetType      ITAssetType   @default(OTHER)
  status         ITAssetStatus @default(ACTIVE)
  assignedToName String?
  location       String?
  purchaseDate   DateTime?
  warrantyExpiry DateTime?
  notes          String?
  createdById    String?
  createdBy      User?         @relation("ITAssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([mineId, assetTag])
}

enum ITTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ITTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model ITTicket {
  id             String           @id @default(cuid())
  mineId         String
  mine           Mine             @relation(fields: [mineId], references: [id], onDelete: Cascade)
  subject        String
  description    String
  status         ITTicketStatus   @default(OPEN)
  priority       ITTicketPriority @default(MEDIUM)
  reportedByName String?
  resolutionNote String?
  resolvedAt     DateTime?
  createdById    String?
  createdBy      User?            @relation("ITTicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Module: Budget Planning (CFO)
// Budgeted amount per category/period/site; actual spend is computed live
// from Expense records rather than duplicated here, so it never drifts.
// ---------------------------------------------------------------------------

model BudgetPlan {
  id             String          @id @default(cuid())
  mineId         String
  mine           Mine            @relation(fields: [mineId], references: [id], onDelete: Cascade)
  siteId         String?
  site           Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  category       ExpenseCategory
  periodStart    DateTime
  periodEnd      DateTime
  budgetedAmount Float
  notes          String?
  createdById    String?
  createdBy      User?           @relation("BudgetPlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Module: Toolbox Talk Tracker (Safety Manager)
// Logged safety briefings/toolbox talks per site — an MHSA-style recurring
// requirement, distinct from formal training courses or safety inspections.
// ---------------------------------------------------------------------------

model ToolboxTalk {
  id            String   @id @default(cuid())
  siteId        String
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  talkDate      DateTime
  topic         String
  presenter     String
  attendeeCount Int
  notes         String?
  createdById   String?
  createdBy     User?    @relation("ToolboxTalkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Module: Regulatory Submissions Tracker (Compliance Officer)
// Outbound filings/reports sent TO regulators (DMRE etc.) with due dates —
// the complement of RegulatoryNotice, which tracks notices received FROM them.
// ---------------------------------------------------------------------------

enum RegulatorySubmissionStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
  OVERDUE
}

model RegulatorySubmission {
  id              String                     @id @default(cuid())
  mineId          String
  mine            Mine                       @relation(fields: [mineId], references: [id], onDelete: Cascade)
  regulator       String
  subject         String
  referenceNumber String?
  dueDate         DateTime?
  submittedDate   DateTime?
  status          RegulatorySubmissionStatus @default(DRAFT)
  notes           String?
  fileName        String?
  fileMimeType    String?
  fileSize        Int?
  fileData        Bytes?
  createdById     String?
  createdBy       User?                      @relation("RegulatorySubmissionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}
