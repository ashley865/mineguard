  status              NoticeStatus   @default(OPEN)
  compliedDate        DateTime?
  siteId              String
  site                Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId              String?
  zone                Zone?          @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  visits InspectionVisit[]

  createdAt DateTime @default(now())
}

enum RequirementFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
  ONCE_OFF
  AD_HOC
}

enum RequirementStatus {
  PENDING
  COMPLIANT
  NON_COMPLIANT
  IN_PROGRESS
  OVERDUE
  NOT_APPLICABLE
}

// The Compliance Officer's Legal & Regulatory Requirements Register: one row per
// applicable law/regulation, tracking who owns it, what proves compliance, and when
// it's next due — distinct from RegulatoryNotice, which tracks notices already issued
// by a regulator rather than the underlying ongoing legal obligations.
model ComplianceRequirement {
  id                     String                @id @default(cuid())
  siteId                 String
  site                   Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  regulation             String
  requirement            String
  applicableOperation    String
  responsibleDepartment  String
  responsiblePersonId    String?
  responsiblePerson      User?                 @relation("RequirementResponsiblePerson", fields: [responsiblePersonId], references: [id], onDelete: SetNull)
  frequency              RequirementFrequency
  evidenceRequired       String
  dueDate                DateTime
  status                 RequirementStatus     @default(PENDING)
  riskLevel              RiskLevel
  lastVerification       DateTime?
  nextReview             DateTime?
  relatedDocuments       String?
  createdById            String?
  createdBy              User?                 @relation("RequirementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

enum AuditFindingStatus {
  OPEN
  IN_PROGRESS
  AWAITING_VERIFICATION
  VERIFIED
  CLOSED
  OVERDUE
}

// The Compliance Officer's audit findings register: one row per finding raised in an
// internal or external audit, tracked through its full lifecycle — Finding, Actions,
// Evidence, Verification, Closure — distinct from ComplianceRequirement, which tracks the
// ongoing legal obligation itself rather than a specific instance of non-conformance.
model AuditFinding {
  id                  String             @id @default(cuid())
  siteId              String
  site                Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  findingNumber       String
  requirementViolated String
  severity            RiskLevel
  description         String
  evidence            String?
  responsiblePersonId String?
  responsiblePerson   User?              @relation("AuditFindingResponsiblePerson", fields: [responsiblePersonId], references: [id], onDelete: SetNull)
  correctiveAction    String
  dueDate             DateTime
  status              AuditFindingStatus @default(OPEN)
  verificationNotes   String?
  verifiedById        String?
  verifiedBy          User?              @relation("AuditFindingVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt          DateTime?
  closureDate         DateTime?
  closedById          String?
  closedBy            User?              @relation("AuditFindingClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  createdById         String?
  createdBy           User?              @relation("AuditFindingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

enum HazardType {
  GEOTECHNICAL_ROCKFALL
  ELECTRICAL
  FIRE_EXPLOSION
  CHEMICAL_SPILL
  MACHINERY_EQUIPMENT
  VENTILATION_AIR_QUALITY
  DUST_NOISE
  SLIP_TRIP_FALL
  WORKING_AT_HEIGHT
  CONFINED_SPACE
  VEHICLE_TRAFFIC
  STRUCTURAL
  ERGONOMIC
  ENVIRONMENTAL
  OTHER
}

enum HazardStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  OVERDUE
}

// The core "HAZARD FOUND" workflow: any worker or supervisor can report a hazard the
// moment they find it, with photo/video evidence, and it's tracked through to closure —
// distinct from SafetyObservation (a lighter-weight behavioural near-miss/unsafe-act log
// with no media, responsible-person, due-date, or closure-evidence workflow).
model HazardReport {
  id                  String        @id @default(cuid())
  siteId              String
  site                Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId              String?
  zone                Zone?         @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  hazardType          HazardType
  location            String
  description         String
  reportedById        String?
  reportedBy          User?         @relation("HazardReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  riskLevel           RiskLevel
  immediateAction     String?
  responsiblePersonId String?
  responsiblePerson   User?         @relation("HazardResponsiblePerson", fields: [responsiblePersonId], references: [id], onDelete: SetNull)
  dueDate             DateTime?
  status              HazardStatus  @default(OPEN)
  closureEvidence     String?
  closedById          String?
  closedBy            User?         @relation("HazardClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closureDate         DateTime?
  media               HazardMedia[]

  createdAt DateTime @default(now())
}

model HazardMedia {
  id             String       @id @default(cuid())
  hazardReportId String
  hazardReport   HazardReport @relation(fields: [hazardReportId], references: [id], onDelete: Cascade)
  fileName       String
  fileMimeType   String
  fileSize       Int
  fileData       Bytes

  createdAt DateTime @default(now())
}

// Occupational Diseases in Mines and Works Act (ODMWA) fields are additional to the
// general fitness-for-work exam above: mining has its own disease-certification regime
// (via the Medical Bureau for Occupational Diseases) for dust-exposed workers, distinct
