  registrationNumber String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  category           String?
  bbbeeLevel         String?
  status             SupplierStatus @default(ACTIVE)

  purchaseOrders PurchaseOrder[]
  payee          Payee?

