// ---------------------------------------------------------------------------

enum DamStructuralRating {
  SATISFACTORY
  FAIR
  POOR
  UNSATISFACTORY
  UNKNOWN
}

// A TSF is the single highest-consequence structure most mines operate (Jagersfontein,
// Brumadinho); it warrants its own register and inspection history rather than being one
// more generic EnvironmentalReading parameter.
model TailingsFacility {
