enum OccupationalDiseaseClassification {
  NONE
  SILICOSIS
  TUBERCULOSIS
  NOISE_INDUCED_HEARING_LOSS
  PNEUMOCONIOSIS_OTHER
  OTHER
}

model MedicalSurveillance {
