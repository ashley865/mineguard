  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

model MaintenanceSchedule {
  id              String                     @id @default(cuid())
  equipmentId     String
  equipment       Equipment                  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  maintenanceType MaintenanceType
  scheduledDate   DateTime
  completedDate   DateTime?
  assignedToId    String?
  // Repairs are assigned to a technician on the workforce roster (Worker), not an
  // executive/admin login account — mirrors who's actually turning the wrench.
  assignedTo      Worker?                    @relation("MaintenanceAssignedToWorker", fields: [assignedToId], references: [id], onDelete: SetNull)
  status          MaintenanceScheduleStatus  @default(SCHEDULED)
  // How long production/equipment was actually down for this event, and why — this is
  // the operations-manager-facing "why did production stop" record, distinct from
  // `findings` which is the technician's post-repair write-up.
  downtimeMinutes Float?
  downtimeReason  String?
  findings        String?
  partsUsed       String?
  cost            Float?
  createdById     String?
  createdBy       User?                      @relation("MaintenanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  partsConsumed MaintenancePartUsed[]
  expense       Expense?

  createdAt DateTime @default(now())
}

