enum ExecutiveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ExecutiveRequestPriority {
  NORMAL
  EMERGENCY
}

// A lightweight inter-executive workflow: one executive (or admin) asks a
// specific executive title to act on something outside their own module —
// e.g. HR sending a payroll list to the CFO for payment. Routed by title
// rather than a named user since that's how every other permission check
// in this app already identifies "the CFO" / "the GM" etc.
model ExecutiveRequest {
  id            String                 @id @default(cuid())
  mineId        String
  mine          Mine                   @relation(fields: [mineId], references: [id], onDelete: Cascade)
  fromUserId    String
  fromUser      User                   @relation("ExecutiveRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toTitle       ExecutiveTitle
  category      String
  subject       String
  message       String
  // Optional monetary amount for categories/departments where a request is
  // inherently about a sum of money (e.g. a CFO payment approval).
  amount        Float?
  priority      ExecutiveRequestPriority @default(NORMAL)
  status        ExecutiveRequestStatus @default(PENDING)
  responseNote  String?
  respondedById String?
  respondedBy   User?                  @relation("ExecutiveRequestRespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)
  respondedAt   DateTime?

  fileName     String?
  fileMimeType String?
  fileSize     Int?
  fileData     Bytes?

  // Set once this request is approved with an amount attached — the same cost flows
  // into the main Expenses ledger so Finance sees it alongside every other expense.
  expense   Expense?

  createdAt DateTime @default(now())
}

