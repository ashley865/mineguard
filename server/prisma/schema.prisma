  currency                  String                @default("ZAR")
  guaranteeInstrument       String?
  lastAssessmentDate        DateTime?
  nextAssessmentDue         DateTime?
  targetClosureDate         DateTime?
  status                    RehabilitationStatus  @default(PLANNED)
  notes                     String?

