  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unitPrice   Float
  lineTotal   Float

  createdAt DateTime @default(now())
}

enum PayeeType {
  COMPANY
  INDIVIDUAL
  BUYER
  CONTRACTOR
  EMPLOYEE
  SUPPLIER
}

model Payee {
  id                 String    @id @default(cuid())
  mineId             String
  mine               Mine      @relation(fields: [mineId], references: [id], onDelete: Cascade)
  payeeType          PayeeType @default(COMPANY)
  name               String
  registrationNumber String?
  taxNumber          String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  bankName           String?
  bankAccountHolder  String?
  bankAccountNumber  String?
  bankBranchCode     String?
  notes              String?
  createdById        String?
  createdBy          User?     @relation("PayeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Auto-synced payees for payroll: linked back to their source Worker or
  // Executive User so the payee list can stay in step with staff records
  // without HR having to hand-create a duplicate entry for every hire.
  workerId    String? @unique
  worker      Worker? @relation(fields: [workerId], references: [id], onDelete: SetNull)
  linkedUserId String? @unique
  linkedUser   User?  @relation("PayeeLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  // Auto-synced payees for procurement and awarded contracts, mirroring the worker/user
  // sync above, so every cost source gets a real payee to route its Expense through.
  supplierId     String?      @unique
  supplier       Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  contractBidId  String?      @unique
  contractBid    ContractBid? @relation(fields: [contractBidId], references: [id], onDelete: SetNull)

  expenses Expense[]
  payslips Payslip[]

  createdAt DateTime @default(now())
}

enum ExpenseCategory {
  OPERATIONS
  MAINTENANCE
  SALARIES_WAGES
  TRANSPORT_LOGISTICS
  UTILITIES
  PROFESSIONAL_SERVICES
  EQUIPMENT_SUPPLIES
  RENT_LEASE
  INSURANCE
  TAXES_LEVIES
  OTHER
}

enum ExpenseStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  EFT
  CASH
  CHEQUE
  CARD
  OTHER
}

model Expense {
  id             String          @id @default(cuid())
  siteId         String
  site           Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  payeeId        String
  payee          Payee           @relation(fields: [payeeId], references: [id], onDelete: Restrict)
  expenseNumber  String
  category       ExpenseCategory @default(OTHER)
  description    String
  amount         Float
  currency       String          @default("ZAR")
  expenseDate    DateTime        @default(now())
  paymentMethod  PaymentMethod   @default(EFT)
  // Every expense starts PENDING, regardless of who logs it, and can only move to
  // PAID/CANCELLED via the dedicated CFO-gated review endpoint — logging an expense is
  // not the same as approving it for payment.
  status         ExpenseStatus   @default(PENDING)
  reviewedById   String?
  reviewedBy     User?           @relation("ExpenseReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  reviewNote     String?
  referenceNumber String?
  notes          String?
  documentId     String?
  document       Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?           @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  // Set when this expense was auto-generated from some other cost-incurring event —
  // an issued payslip, an approved purchase order, a completed maintenance job, or an
  // awarded contract bid — so every cost anyone in the mine incurs flows through the
  // same CFO approval pipeline rather than being settled outside Finance's view.
  payslipId              String?              @unique
  payslip                Payslip?             @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  purchaseOrderId        String?              @unique
  purchaseOrder          PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  maintenanceScheduleId  String?              @unique
  maintenanceSchedule    MaintenanceSchedule? @relation(fields: [maintenanceScheduleId], references: [id], onDelete: Cascade)
  contractBidId          String?              @unique
  contractBid            ContractBid?         @relation(fields: [contractBidId], references: [id], onDelete: Cascade)
  executiveRequestId     String?              @unique
  executiveRequest       ExecutiveRequest?    @relation(fields: [executiveRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Module: Statutory Appointments Register (Mine Health & Safety Act s2.1)
// ---------------------------------------------------------------------------

enum StatutoryAppointmentType {
  MINE_MANAGER
  MINE_OVERSEER
  ENGINEER
  SURVEYOR
  VENTILATION_OFFICER
  HEALTH_SAFETY_OFFICER
  BLASTING_OFFICER
  ROCK_ENGINEER
  ELECTRICAL_ENGINEER
  MECHANICAL_ENGINEER
  ASSISTANT_MANAGER
  ENVIRONMENTAL_CONTROL_OFFICER
  OCCUPATIONAL_HYGIENIST
  OTHER
}

enum StatutoryAppointmentStatus {
  ACTIVE
  VACANT
  SUSPENDED
  EXPIRED
  REVOKED
}

// The MHSA requires named, certificated individuals formally appointed to specific legal
// roles at each mine (Mine Manager, Engineer, Ventilation Officer, etc.), each traceable to
// an appointment letter and a competency certificate — distinct from just holding a
// Certificate, which only proves competence, not that someone is *currently* the legally
// accountable appointee for that role at this site.
model StatutoryAppointment {
  id                   String                     @id @default(cuid())
  siteId               String
  site                 Site                       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  appointmentType      StatutoryAppointmentType
  customTitle          String?
  legislativeReference String?
  workerId             String?
  worker               Worker?                    @relation(fields: [workerId], references: [id], onDelete: SetNull)
  appointeeName        String
  certificateId        String?
  certificate          Certificate?               @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  appointedDate        DateTime
  status               StatutoryAppointmentStatus @default(ACTIVE)
  scopeOfAppointment   String?
  notes                String?
  letterFileName       String?
  letterFileMimeType   String?
  letterFileSize       Int?
  letterFileData       Bytes?
  appointedById        String?
  appointedBy          User?                      @relation("StatutoryAppointmentAppointedBy", fields: [appointedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Module: COIDA Injury-on-Duty Claims
// ---------------------------------------------------------------------------

enum IodClaimStatus {
  REPORTED
  SUBMITTED
  UNDER_ASSESSMENT
  ACCEPTED
  REJECTED
  CLOSED
}

// Tracks a workplace injury through the Compensation for Occupational Injuries and Diseases
// Act (COIDA) claim lifecycle — separate from the Incident record itself, since not every
// incident becomes a compensation claim, and a claim has its own legal paper trail
// (Form W.Cl.2, medical reports, Compensation Fund claim number and payout).
model IodClaim {
  id                 String         @id @default(cuid())
  incidentId         String?
  incident           Incident?      @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  workerId           String
  worker             Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  claimNumber        String?
  dateOfInjury       DateTime
  natureOfInjury     String
  wclForm2Filed      Boolean        @default(false)
  wclForm2FiledAt    DateTime?
  firstMedicalReport String?
  finalMedicalReport String?
  status             IodClaimStatus @default(REPORTED)
  compensationAmount Float?
  payoutDate         DateTime?
  notes              String?
  reportedById       String?
  reportedBy         User?          @relation("IodClaimReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Module: Explosives & Blasting — blast logs (extends the existing magazine register)
// ---------------------------------------------------------------------------

enum BlastLogStatus {
  PLANNED
  FIRED
  MISFIRE
  CANCELLED
}

// The existing ExplosivesMagazine/ExplosivesTransaction models cover magazine stock
// control; a blast itself is a separate legal event under the Explosives Act and MHSA
// blasting regulations, requiring a certificated shot-firer, a clearance sign-off before
// re-entry, and misfire handling.
model BlastLog {
  id                  String              @id @default(cuid())
  siteId              String
  site                Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId              String?
  zone                Zone?               @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  magazineId          String?
  magazine            ExplosivesMagazine? @relation(fields: [magazineId], references: [id], onDelete: SetNull)
  shotFirerId         String?
  shotFirer           Worker?             @relation("BlastLogShotFirer", fields: [shotFirerId], references: [id], onDelete: SetNull)
  blastDate           DateTime
  explosiveType       String
  quantityUsed        Float
  unit                String
  numberOfHoles       Int?
  misfireOccurred     Boolean             @default(false)
  misfireResolution   String?
  clearanceGivenById  String?
  clearanceGivenBy    User?               @relation("BlastLogClearanceGivenBy", fields: [clearanceGivenById], references: [id], onDelete: SetNull)
  clearanceTime       DateTime?
  sapsNotified        Boolean             @default(false)
  status              BlastLogStatus      @default(PLANNED)
  notes               String?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
