// ---------------------------------------------------------------------------
// Module: Legal & Regulatory Compliance Calendar
// ---------------------------------------------------------------------------

enum LegalComplianceCategory {
  MINING_RIGHT
  ENVIRONMENTAL
  WATER_USE
  LABOUR
  HEALTH_SAFETY
  TAX_LEVY
  OTHER
}

enum LegalComplianceItemStatus {
  UPCOMING
  DUE
  OVERDUE
  COMPLETED
}

// Manually-tracked legal deadlines that aren't already represented by another module's own
// expiry field (e.g. a mining-right renewal filing date, a DMRE inspection visit, an SLP
// review). The /legal-compliance calendar endpoint merges these with expiry dates already
// captured on Permit, Certificate, MedicalSurveillance and ExplosivesMagazine, so this table
// is additive rather than a duplicate source of truth for things already tracked elsewhere.
model LegalComplianceItem {
  id                    String                     @id @default(cuid())
  mineId                String
  mine                  Mine                       @relation(fields: [mineId], references: [id], onDelete: Cascade)
  siteId                String?
  site                  Site?                      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  category              LegalComplianceCategory
  title                 String
  legislativeReference  String?
  dueDate               DateTime
  ownerId               String?
  owner                 User?                      @relation("LegalComplianceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  status                LegalComplianceItemStatus  @default(UPCOMING)
  completedAt           DateTime?
  notes                 String?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Module: Ground Control & Geotechnical Management (MHSA Rockfall/Rockburst COP)
// ---------------------------------------------------------------------------

enum GeotechnicalPointType {
  EXTENSOMETER
  CONVERGENCE_STATION
  TILTMETER
  PIEZOMETER
  OTHER
}

enum GeotechnicalEventType {
  ROCKFALL
  ROCKBURST
}

// A ground control district is the area a support standard applies to — the unit that
// monitoring points, seismic events and rockfall/rockburst incidents are all scoped to.
model GroundControlDistrict {
  id                      String   @id @default(cuid())
  siteId                  String
  site                    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId                  String?
  zone                    Zone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  name                    String
  requiredSupportStandard String?
  status                  String   @default("ACTIVE")

  monitoringPoints  GeotechnicalMonitoringPoint[]
  rockfallIncidents RockfallIncident[]

  createdAt DateTime @default(now())
}

model GeotechnicalMonitoringPoint {
  id                  String                @id @default(cuid())
  districtId          String
  district            GroundControlDistrict @relation(fields: [districtId], references: [id], onDelete: Cascade)
  pointType           GeotechnicalPointType
  locationDescription String
  installedDate       DateTime?
  status              String                @default("ACTIVE")

  readings GeotechnicalReading[]

  createdAt DateTime @default(now())
}

model GeotechnicalReading {
  id                String                      @id @default(cuid())
  pointId           String
  point             GeotechnicalMonitoringPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  readingDate       DateTime
  value             Float
  unit              String
  alertThreshold    Float?
  exceedsThreshold  Boolean                     @default(false)
  notes             String?
  recordedById      String?
  recordedBy        User?                       @relation("GeotechReadingRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
