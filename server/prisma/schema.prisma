model ClosureRehabilitationProgress {
  id                    String                    @id @default(cuid())
  planId                String
  plan                  ClosureRehabilitationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  updateDate            DateTime                  @default(now())
  hectaresRehabilitated Float?
  percentComplete       Float?
  description           String
  recordedById          String?
  recordedBy            User?                     @relation("RehabProgressRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Module: Employment Equity & Mining Charter Scorecard
