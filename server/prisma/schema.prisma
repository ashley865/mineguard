generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
  VIEWER
  EXECUTIVE
}

enum ExecutiveTitle {
  GENERAL_MANAGER
  CFO
  COO
  HR_MANAGER
  SECURITY_MANAGER
  SAFETY_MANAGER
  OPERATIONS_MANAGER
  COMPLIANCE_OFFICER
  IT_MANAGER
  OTHER
}

enum ExecReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SiteStatus {
  OPERATIONAL
  RESTRICTED
  SHUT_DOWN
}

// The full catalog of sensor types a mine may ever need to install, not just the ones
// currently in use — surfaced in the client as a browsable reference (Sensor Catalog) so
// gaps in coverage per site are visible, alongside the live Sensor records below.
enum SensorType {
  METHANE
  CARBON_MONOXIDE
  OXYGEN
  TEMPERATURE
  HUMIDITY
  SEISMIC
  AIR_FLOW
  DUST
  NOISE
  WATER_LEVEL
  EQUIPMENT_CONDITION
  CARBON_DIOXIDE
  NITROGEN_OXIDES
  SULFUR_DIOXIDE
  HYDROGEN_SULFIDE
  RADIATION
  SMOKE_FIRE
  VIBRATION
  PRESSURE
  FLOW_RATE
  CONVEYOR_ALIGNMENT
  PROXIMITY_COLLISION
  GPS_LOCATION
  PUMP_STATUS
  FAN_STATUS
  ACCESS_CONTROL
}

enum SensorStatus {
  ACTIVE
  INACTIVE
  FAULT
}

// A sensor's physical installation lifecycle, independent of its operational SensorStatus
// above — a sensor can be REQUESTED long before it exists, and only becomes eligible for
// ACTIVE/readings once COMMISSIONED.
enum SensorInstallationStatus {
  REQUESTED
  SCHEDULED
  INSTALLED
  COMMISSIONED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum WorkerStatus {
  ON_SHIFT
  OFF_SHIFT
  EMERGENCY
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

enum EquipmentStatus {
  OPERATIONAL
  MAINTENANCE
  DOWN
}

enum CopCategory {
  ROCK_ENGINEERING
  VENTILATION
  EXPLOSIVES
  FALL_OF_GROUND
  TRACKLESS_MOBILE_MACHINERY
  WINDING_PLANT
  ELECTRICAL
  OCCUPATIONAL_HEALTH
  EMERGENCY_PREPAREDNESS
  OTHER
}

enum CopStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  EXPIRED
  WITHDRAWN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskAssessmentStatus {
  DRAFT
  APPROVED
  UNDER_REVIEW
  EXPIRED
}

enum RiskMitigationStatus {
  OPEN
  IN_PROGRESS
  MITIGATED
  ACCEPTED
}

enum NoticeSection {
  SECTION_54
  SECTION_55
  SECTION_53
  OTHER
}

enum NoticeStatus {
  OPEN
  COMPLIED
  WITHDRAWN
  APPEALED
}

enum ExamType {
  PRE_EMPLOYMENT
  PERIODICAL
  EXIT
  RETURN_TO_WORK
}

enum FitnessResult {
  FIT
  FIT_WITH_RESTRICTION
  TEMPORARILY_UNFIT
  UNFIT
}

enum InspectionStatus {
  SCHEDULED
  COMPLETED
  OVERDUE
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String
  role         Role            @default(VIEWER)
  title        ExecutiveTitle?
  photoData    Bytes?
  photoMimeType String?
  // Set to false when an owner removes an executive: blocks login entirely rather than
  // just demoting the role, so a removed executive can't fall back to viewer access.
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())

  mineId String?
  mine   Mine?   @relation(fields: [mineId], references: [id], onDelete: SetNull)

  acknowledgedAlerts Alert[]    @relation("AlertAcknowledgedBy")
  reportedIncidents  Incident[] @relation("IncidentReportedBy")
  reviewedAlerts     Alert[]    @relation("AlertReviewedBy")
  reviewedIncidents  Incident[] @relation("IncidentReviewedBy")
  uploadedDocuments  Document[]

  siteAssignments        ExecutiveSiteAssignment[]
  ptwSupervisorDecisions PermitToWork[]             @relation("PtwSupervisorDecision")
  ptwExecutiveDecisions  PermitToWork[]             @relation("PtwExecutiveDecision")
  createdInvites         ExecutiveInvite[]          @relation("InviteCreatedBy")
  acceptedInvite         ExecutiveInvite?           @relation("InviteAcceptedUser")
  loggedDeliveries       Delivery[]
  sentMessages           Message[]                  @relation("MessageSender")
  receivedMessages       Message[]                  @relation("MessageRecipient")
  reviewedBuyers         Buyer[]
  listedMinerals         MineralListing[]
  postedContracts        ContractOpportunity[]
  productionRecords      ProductionRecord[]     @relation("ProductionRecordedBy")
  maintenanceSchedules   MaintenanceSchedule[]  @relation("MaintenanceCreatedBy")
  requirementsCreated    ComplianceRequirement[] @relation("RequirementCreatedBy")
  requirementsResponsibleFor ComplianceRequirement[] @relation("RequirementResponsiblePerson")
  auditFindingsCreated       AuditFinding[]          @relation("AuditFindingCreatedBy")
  auditFindingsResponsibleFor AuditFinding[]         @relation("AuditFindingResponsiblePerson")
  auditFindingsVerified      AuditFinding[]          @relation("AuditFindingVerifiedBy")
  auditFindingsClosed        AuditFinding[]          @relation("AuditFindingClosedBy")
  securityCamerasCreated     SecurityCamera[]        @relation("SecurityCameraCreatedBy")
  securityIncidentsReported  SecurityIncident[]      @relation("SecurityIncidentReportedBy")
  patrolRoutesCreated        PatrolRoute[]           @relation("PatrolRouteCreatedBy")
  patrolAssignmentsAssigned  PatrolAssignment[]      @relation("PatrolAssignmentAssignedBy")
  hazardReportsReported      HazardReport[]          @relation("HazardReportedBy")
  hazardReportsResponsibleFor HazardReport[]         @relation("HazardResponsiblePerson")
  hazardReportsClosed        HazardReport[]          @relation("HazardClosedBy")
  ppeRequirementsCreated     WorkerPpeRequirement[]  @relation("PpeRequirementCreatedBy")
  workerDocumentsUploaded    WorkerDocument[]        @relation("WorkerDocumentUploadedBy")
  emergencyEventsReported    EmergencyEvent[]        @relation("EmergencyEventReportedBy")
  fleetPositions         FleetPosition[]        @relation("FleetPositionRecordedBy")
  inventoryMovements     InventoryMovement[]    @relation("InventoryMovementBy")
  weatherReadings        WeatherReading[]       @relation("WeatherRecordedBy")
  safetyObservations     SafetyObservation[]    @relation("SafetyObservationReportedBy")
  explosivesTransactions ExplosivesTransaction[] @relation("ExplosivesAuthorizedBy")
  environmentalReadings  EnvironmentalReading[]  @relation("EnvironmentalRecordedBy")
  evacuationDrills       EvacuationDrill[]       @relation("DrillConductedBy")
  shiftRosters           ShiftRoster[]           @relation("RosterCreatedBy")
  leaveApprovals         LeaveRequest[]          @relation("LeaveApprovedBy")
  payslipsUploaded       Payslip[]               @relation("PayslipUploadedBy")
  poRequests             PurchaseOrder[]         @relation("PORequestedBy")
  poApprovals            PurchaseOrder[]         @relation("POApprovedBy")
  invoicesCreated        Invoice[]               @relation("InvoiceCreatedBy")
  payeesCreated          Payee[]                 @relation("PayeeCreatedBy")
  expensesCreated        Expense[]               @relation("ExpenseCreatedBy")
  expensesReviewed       Expense[]               @relation("ExpenseReviewedBy")
  evacuationsTriggered   EmergencyEvacuation[]   @relation("EvacuationTriggeredBy")
  evacuationsCancelled   EmergencyEvacuation[]   @relation("EvacuationCancelledBy")
  attendance             UserAttendance[]
  employeePayee          Payee?                  @relation("PayeeLinkedUser")
  requestsSent           ExecutiveRequest[]      @relation("ExecutiveRequestFrom")
  requestsResponded      ExecutiveRequest[]      @relation("ExecutiveRequestRespondedBy")
  messageGroupsCreated   MessageGroup[]          @relation("MessageGroupCreatedBy")
  messageGroupMemberships MessageGroupMember[]
  visitorApprovals       Visitor[]               @relation("VisitorApprovedBy")
  complianceChecksAssessed EmployeeComplianceCheck[] @relation("EmployeeComplianceAssessedBy")

  statutoryAppointmentsMade StatutoryAppointment[]  @relation("StatutoryAppointmentAppointedBy")
  iodClaimsReported         IodClaim[]              @relation("IodClaimReportedBy")
  blastClearancesGiven      BlastLog[]              @relation("BlastLogClearanceGivenBy")
  rehabProgressRecorded     ClosureRehabilitationProgress[] @relation("RehabProgressRecordedBy")
  learnershipsRecorded      Learnership[]           @relation("LearnershipRecordedBy")
  legalComplianceItemsOwned LegalComplianceItem[]   @relation("LegalComplianceOwner")

  geotechReadingsRecorded  GeotechnicalReading[] @relation("GeotechReadingRecordedBy")
  rockfallSignOffs         RockfallIncident[]    @relation("RockfallSignOffBy")
  rescueDrillsConducted    RescueDrill[]         @relation("RescueDrillConductedBy")
  disciplinaryCasesCreated DisciplinaryCase[]    @relation("DisciplinaryCaseCreatedBy")

  sensorsRequested    Sensor[] @relation("SensorRequestedBy")
  sensorsInstalled    Sensor[] @relation("SensorInstalledBy")
  sensorsCommissioned Sensor[] @relation("SensorCommissionedBy")
  communityEngagementsFacilitated CommunityEngagement[] @relation("CommunityEngagementFacilitatedBy")
  auditLogsChanged AuditLog[]
  aiRecommendationsReviewed AiRecommendation[] @relation("AiRecommendationReviewedBy")
  requisitionsRequested JobRequisition[] @relation("RequisitionRequestedBy")
  requisitionsApproved JobRequisition[] @relation("RequisitionApprovedBy")
  candidatesCreated Candidate[] @relation("CandidateCreatedBy")
  onboardingChecklistsCreated OnboardingChecklist[] @relation("OnboardingChecklistCreatedBy")

  gatePassesIssued          GatePass[]                @relation("GatePassIssuedBy")
  gateLogsLogged            GateLog[]                 @relation("GateLogLoggedBy")
  blacklistEntriesAdded     SecurityBlacklistEntry[]  @relation("BlacklistAddedBy")
  investigationsLed         SecurityInvestigation[]   @relation("InvestigationLead")
  investigationsCreated     SecurityInvestigation[]   @relation("InvestigationCreatedBy")
  investigationEvidenceAdded InvestigationEvidence[]  @relation("EvidenceAddedBy")
  investigationStatementsRecorded InvestigationStatement[] @relation("StatementRecordedBy")
  securityKeysCreated       SecurityKey[]             @relation("SecurityKeyCreatedBy")
  keyIssueLogsLogged        KeyIssueLog[]             @relation("KeyIssueLogLoggedBy")
  securityAssetsCreated     SecurityAsset[]           @relation("SecurityAssetCreatedBy")
  securityAssetLogsLogged   SecurityAssetAssignmentLog[] @relation("SecurityAssetLogLoggedBy")

  shiftHandoversCreated       ShiftHandover[]        @relation("ShiftHandoverCreatedBy")
  downtimeEventsCreated       DowntimeEvent[]        @relation("DowntimeEventCreatedBy")
  itAssetsCreated              ITAsset[]              @relation("ITAssetCreatedBy")
  itTicketsCreated              ITTicket[]             @relation("ITTicketCreatedBy")
  budgetPlansCreated           BudgetPlan[]           @relation("BudgetPlanCreatedBy")
  toolboxTalksCreated          ToolboxTalk[]          @relation("ToolboxTalkCreatedBy")
  regulatorySubmissionsCreated RegulatorySubmission[] @relation("RegulatorySubmissionCreatedBy")
}

model UserAttendance {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkInAt  DateTime  @default(now())
  checkOutAt DateTime?

  createdAt DateTime @default(now())
}

model Site {
  id          String     @id @default(cuid())
  name        String
  location    String
  description String?
  status      SiteStatus @default(OPERATIONAL)
  // Resolved once from `location` text via the free Open-Meteo geocoder and cached here
  // permanently (rather than re-resolved from an in-memory cache every server restart) —
  // both so weather lookups always use a stable point rather than whatever the geocoder
  // happens to return that day, and so the same coordinate can be plotted on the site map.
  latitude    Float?
  longitude   Float?
  geocodedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  mineId String
  mine   Mine   @relation(fields: [mineId], references: [id], onDelete: Cascade)

  zones     Zone[]
  workers   Worker[]
  incidents Incident[]
  equipment Equipment[]
  alerts    Alert[]

  codesOfPractice   CodeOfPractice[]
  riskAssessments   RiskAssessment[]
  regulatoryNotices RegulatoryNotice[]
  safetyInspections SafetyInspection[]
  permits           Permit[]
  documents         Document[]
  inspectionVisits  InspectionVisit[]
  contractors       Contractor[]

  executiveAssignments ExecutiveSiteAssignment[]
  visitors             Visitor[]
  permitsToWork        PermitToWork[]
  deliveries           Delivery[]
  mineralListings      MineralListing[]
  contractOpportunities ContractOpportunity[]
  productionRecords    ProductionRecord[]
  fleetPositions       FleetPosition[]
  inventoryItems       InventoryItem[]
  weatherReadings      WeatherReading[]
  safetyObservations   SafetyObservation[]
  explosivesMagazines  ExplosivesMagazine[]
  environmentalReadings EnvironmentalReading[]
  emergencyContacts    EmergencyContact[]
  evacuationDrills     EvacuationDrill[]
  shiftRosters         ShiftRoster[]
  trainingCourses      TrainingCourse[]
  purchaseOrders       PurchaseOrder[]
  invoices             Invoice[]
  expenses             Expense[]
  evacuations          EmergencyEvacuation[]
  complianceRequirements ComplianceRequirement[]
  auditFindings          AuditFinding[]
  securityCameras        SecurityCamera[]
  securityIncidents      SecurityIncident[]
  patrolRoutes           PatrolRoute[]
  patrolAssignments      PatrolAssignment[]
  hazardReports          HazardReport[]
  emergencyEvents        EmergencyEvent[]

  statutoryAppointments  StatutoryAppointment[]
  blastLogs              BlastLog[]
  tailingsFacilities     TailingsFacility[]
  closureRehabilitationPlans ClosureRehabilitationPlan[]
  legalComplianceItems   LegalComplianceItem[]

  groundControlDistricts GroundControlDistrict[]
  seismicEvents          SeismicEvent[]
  rockfallIncidents      RockfallIncident[]
  ventilationDistricts   VentilationDistrict[]
  refugeBays             RefugeBay[]
  rescueTeamMembers      RescueTeamMember[]
  breathingApparatusSets BreathingApparatusSet[]
  rescueDrills           RescueDrill[]
  mutualAidAgreements    MutualAidAgreement[]
  rescueCallouts         RescueCallout[]
  waterBalanceRecords    WaterBalanceRecord[]
  pollutionControlDams   PollutionControlDam[]
  acidMineDrainageReadings AcidMineDrainageReading[]
  energyConsumptionRecords EnergyConsumptionRecord[]

  communityProjects     CommunityProject[]
  communityEngagements  CommunityEngagement[]
  communityGrievances   CommunityGrievance[]
  communitySpendRecords CommunitySpendRecord[]
  drillHoles            DrillHole[]
  resourceEstimates     ResourceEstimate[]
  winders               Winder[]
  shaftInspections      ShaftInspection[]
  patrolLogEntries      PatrolLogEntry[]
  jobRequisitions       JobRequisition[]

  gatePasses             GatePass[]
  gateLogs               GateLog[]
  securityBlacklistEntries SecurityBlacklistEntry[]
  securityInvestigations  SecurityInvestigation[]
  securityKeys            SecurityKey[]
  securityAssets          SecurityAsset[]

  shiftHandovers  ShiftHandover[]
  downtimeEvents  DowntimeEvent[]
  budgetPlans     BudgetPlan[]
  toolboxTalks    ToolboxTalk[]
}

model Zone {
  id          String  @id @default(cuid())
  name        String
  description String?
  siteId      String
  site        Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  sensors   Sensor[]
  workers   Worker[]
  incidents Incident[]
  equipment Equipment[]
  alerts    Alert[]
  securityCameras SecurityCamera[]
  securityIncidents SecurityIncident[]
  hazardReports HazardReport[]
  emergencyEvents EmergencyEvent[]

  codesOfPractice   CodeOfPractice[]
  riskAssessments   RiskAssessment[]
  regulatoryNotices RegulatoryNotice[]
  safetyInspections SafetyInspection[]
  productionRecords ProductionRecord[]
  safetyObservations SafetyObservation[]
  blastLogs          BlastLog[]

  groundControlDistricts GroundControlDistrict[]
  seismicEvents          SeismicEvent[]
  rockfallIncidents      RockfallIncident[]
  ventilationDistricts   VentilationDistrict[]
  refugeBays             RefugeBay[]

  createdAt DateTime @default(now())
}

model Sensor {
  id       String       @id @default(cuid())
  name     String
  type     SensorType
  unit     String
  minSafe  Float
  maxSafe  Float
  status   SensorStatus @default(ACTIVE)
  zoneId   String
  zone     Zone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  installationStatus SensorInstallationStatus @default(COMMISSIONED)
  manufacturer       String?
  model              String?
  serialNumber       String?
  installationNotes  String?

  requestedById String?
  requestedBy   User?     @relation("SensorRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedAt   DateTime?
  scheduledDate DateTime?

  installedById String?
  installedBy   User?     @relation("SensorInstalledBy", fields: [installedById], references: [id], onDelete: SetNull)
  installedAt   DateTime?

  commissionedById String?
  commissionedBy   User?     @relation("SensorCommissionedBy", fields: [commissionedById], references: [id], onDelete: SetNull)
  commissionedAt   DateTime?

  readings SensorReading[]
  alerts   Alert[]

  createdAt DateTime @default(now())
}

model SensorReading {
  id         String   @id @default(cuid())
  sensorId   String
  sensor     Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  value      Float
  recordedAt DateTime @default(now())

  @@index([sensorId, recordedAt])
}

model Alert {
  id             String        @id @default(cuid())
  siteId         String
  site           Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId         String?
  zone           Zone?         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  sensorId       String?
  sensor         Sensor?       @relation(fields: [sensorId], references: [id], onDelete: SetNull)
  severity       AlertSeverity
  message        String
  status         AlertStatus   @default(OPEN)
  createdAt      DateTime      @default(now())
  acknowledgedAt DateTime?
  acknowledgedById String?
  acknowledgedBy   User?       @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?

  reviewStatus ExecReviewStatus @default(PENDING)
  reviewNote   String?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?            @relation("AlertReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
}

enum StaffCategory {
  MINING_OPERATIONS
  ENGINEERING_TECHNICAL
  DRIVER
  CLEANER
  SECURITY
  ADMINISTRATION
  EXECUTIVE
  MEDICAL
  SAFETY_HEALTH
  MAINTENANCE
  CATERING
  OTHER
}

model Worker {
  id            String        @id @default(cuid())
  name          String
  employeeId    String        @unique
  role          String
  category      StaffCategory @default(OTHER)
  phone         String?
  status        WorkerStatus @default(OFF_SHIFT)
  photoData     Bytes?
  photoMimeType String?
  // A unique unguessable token for this worker's personal patrol duty link
  // (/patrol/g/:dutyToken) — generated on demand by the Security Manager, one per
  // guard, rather than everyone sharing a single site-wide link with a name picker.
  dutyToken     String?      @unique
  siteId        String
  site          Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId        String?
  zone          Zone?        @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  managerId     String?
  manager       Worker?      @relation("WorkerManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports Worker[]     @relation("WorkerManager")

  nextOfKinName         String?
  nextOfKinRelationship String?
  nextOfKinPhone        String?

  medicalRecords  MedicalSurveillance[]
  certificates    Certificate[]
  trainingRecords TrainingRecord[]
  complianceChecks EmployeeComplianceCheck[]
  ppeRequirements  WorkerPpeRequirement[]
  attendance      WorkerAttendance[]
  rosterAssignments   RosterAssignment[]
  trainingEnrollments TrainingEnrollment[]
  leaveRequests   LeaveRequest[]
  payslips        Payslip[]
  payee           Payee?
  assignedEquipment      Equipment[]           @relation("EquipmentAssignedOperator")
  maintenanceAssignments MaintenanceSchedule[] @relation("MaintenanceAssignedToWorker")
  patrolAssignments      PatrolAssignment[]
  evacuationsTriggered   EmergencyEvacuation[] @relation("EvacuationTriggeredByGuard")
  documents              WorkerDocument[]

  statutoryAppointments StatutoryAppointment[]
  iodClaims             IodClaim[]
  blastLogsAsShotFirer  BlastLog[]             @relation("BlastLogShotFirer")
  learnerships          Learnership[]
  leaveBalances         LeaveBalance[]

  occupationalExposureRecords OccupationalExposureRecord[]
  rescueTeamMemberships       RescueTeamMember[]
  disciplinaryCases           DisciplinaryCase[]
  grievanceCases               GrievanceCase[]
  ccmaCases                    CcmaCase[]
  patrolLogEntries             PatrolLogEntry[]
  hiredFromCandidate           Candidate?
  onboardingChecklist          OnboardingChecklist?

  keysCurrentlyHeld  SecurityKey[]  @relation("SecurityKeyCurrentHolder")
  keyIssueLogs       KeyIssueLog[]  @relation("KeyIssueLogWorker")

  securityAssetsAssigned SecurityAsset[]               @relation("SecurityAssetAssignedWorker")
  securityAssetLogs      SecurityAssetAssignmentLog[]  @relation("SecurityAssetLogWorker")

  createdAt DateTime @default(now())
}

enum WorkerDocumentType {
  ID_DOCUMENT
  CERTIFICATE
  CV_RESUME
  QUALIFICATION
  PROOF_OF_ADDRESS
  BANKING_DETAILS
  MEDICAL_CERTIFICATE
  CONTRACT
  OTHER
}

// HR's onboarding document set for a worker — ID copy, certificates, CV, qualifications,
// etc. POPIA-sensitive personal information, so downloads are restricted the same way as
// the generic Document vault's worker-certificate filtering (documents.ts).
model WorkerDocument {
  id           String             @id @default(cuid())
  workerId     String
  worker       Worker             @relation(fields: [workerId], references: [id], onDelete: Cascade)
  docType      WorkerDocumentType @default(OTHER)
  fileName     String
  fileMimeType String
  fileSize     Int
  fileData     Bytes
  uploadedById String?
  uploadedBy   User?              @relation("WorkerDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model WorkerAttendance {
  id         String    @id @default(cuid())
  workerId   String
  worker     Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  checkInAt  DateTime  @default(now())
  checkOutAt DateTime?

  createdAt DateTime @default(now())
}

model Incident {
  id           String         @id @default(cuid())
  title        String
  description  String
  severity     AlertSeverity
  status       IncidentStatus @default(OPEN)
  siteId       String
  site         Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId       String?
  zone         Zone?          @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  reportedById String?
  reportedBy   User?          @relation("IncidentReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)

  reviewStatus ExecReviewStatus @default(PENDING)
  reviewNote   String?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?            @relation("IncidentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  iodClaims IodClaim[]

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

enum EquipmentType {
  EXCAVATOR
  HAUL_TRUCK
  DRILL_RIG
  LOADER
  DOZER
  GRADER
  CRUSHER
  CONVEYOR
  GENERATOR
  PUMP
  VENTILATION_FAN
  COMPRESSOR
  WINCH
  CRANE
  OTHER
}

model Equipment {
  id              String          @id @default(cuid())
  name            String
  type            EquipmentType
  status          EquipmentStatus @default(OPERATIONAL)
  siteId          String
  site            Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId          String?
  zone            Zone?           @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  lastMaintenance DateTime?
  assignedOperatorId String?
  assignedOperator    Worker?     @relation("EquipmentAssignedOperator", fields: [assignedOperatorId], references: [id], onDelete: SetNull)

  maintenanceSchedules MaintenanceSchedule[]

  createdAt DateTime @default(now())
}

enum CameraType {
  FIXED
  PTZ
  DOME
  THERMAL
  BODY_WORN
  DRONE
  OTHER
}

enum CameraOperationalStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  DECOMMISSIONED
}

// How MineGuard talks to the camera's actual video management system, where that's
// technically supported by the vendor — NOT_INTEGRATED just means the camera is on the
// register for asset-tracking purposes but is monitored solely through its native VMS.
enum VmsIntegrationMethod {
  ONVIF
  RTSP_STREAM
  VENDOR_API
  NVR_EXPORT
  NOT_INTEGRATED
}

enum VmsIntegrationStatus {
  CONNECTED
  DISCONNECTED
  PENDING
  NOT_APPLICABLE
}

// The Security Manager's CCTV & Surveillance register: physical camera inventory plus,
// where the site's VMS/CCTV vendor technically supports it, the integration details
// MineGuard uses to pull live status/health from that external system.
model SecurityCamera {
  id                  String                  @id @default(cuid())
  siteId              String
  site                Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId              String?
  zone                Zone?                   @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  name                String
  location            String
  cameraType          CameraType              @default(FIXED)
  status              CameraOperationalStatus @default(ONLINE)
  coverageDescription String?
  vmsProvider         String?
  integrationMethod   VmsIntegrationMethod    @default(NOT_INTEGRATED)
  integrationStatus   VmsIntegrationStatus    @default(NOT_APPLICABLE)
  streamUrl           String?
  retentionDays       Int?
  installedDate       DateTime?
  lastSyncAt          DateTime?
  notes               String?
  createdById         String?
  createdBy           User?                   @relation("SecurityCameraCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

enum SecurityIncidentCategory {
  THEFT
  UNAUTHORISED_ACCESS
  TRESPASSING
  VANDALISM
  ASSAULT
  PROPERTY_DAMAGE
  SUSPICIOUS_ACTIVITY
  MISSING_EQUIPMENT
  VEHICLE_INCIDENT
  PERIMETER_BREACH
  FRAUD_MISCONDUCT
  EMERGENCY
  OTHER
}

// The Security Manager's incident log: security incidents are logged immediately with
// a category and severity first, with investigation details filled in as they develop —
// distinct from the general Incident model, which covers safety/operational incidents
// rather than security-specific ones (theft, trespassing, assault, etc.).
model SecurityIncident {
  id           String                   @id @default(cuid())
  siteId       String
  site         Site                     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId       String?
  zone         Zone?                    @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  category     SecurityIncidentCategory
  severity     AlertSeverity
  description  String
  location     String?
  occurredAt   DateTime                 @default(now())
  reportedById String?
  reportedBy   User?                    @relation("SecurityIncidentReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  status       IncidentStatus           @default(OPEN)
  actionsTaken String?
  resolvedAt   DateTime?

  investigation SecurityInvestigation?

  createdAt DateTime @default(now())
}

enum PatrolAssignmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  MISSED
}

// A named sequence of checkpoints a guard walks/drives during a shift (e.g. Gate 1 ->
// Warehouse -> Plant -> Fuel Station -> Gate). Managed by the Security Manager from the
// authenticated dashboard; guards themselves only ever see it read-only via their duty link.
model PatrolRoute {
  id          String             @id @default(cuid())
  siteId      String
  site        Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean            @default(true)
  checkpoints PatrolCheckpoint[]
  assignments PatrolAssignment[]
  createdById String?
  createdBy   User?              @relation("PatrolRouteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model PatrolCheckpoint {
  id          String           @id @default(cuid())
  routeId     String
  route       PatrolRoute      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  sequence    Int
  name        String
  description String?
  logs        PatrolLogEntry[]

  createdAt DateTime @default(now())

  @@unique([routeId, sequence])
}

// One guard's patrol for one shift: which route, current progress, and the checkpoint/
// ad-hoc photo log entries they've submitted from the public duty portal.
model PatrolAssignment {
  id           String                 @id @default(cuid())
  routeId      String
  route        PatrolRoute            @relation(fields: [routeId], references: [id], onDelete: Cascade)
  workerId     String
  worker       Worker                 @relation(fields: [workerId], references: [id], onDelete: Cascade)
  siteId       String
  site         Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  shiftDate    DateTime
  status       PatrolAssignmentStatus @default(SCHEDULED)
  startedAt    DateTime?
  completedAt  DateTime?
  notes        String?
  assignedById String?
  assignedBy   User?                  @relation("PatrolAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  logs         PatrolLogEntry[]

  createdAt DateTime @default(now())
}

// A checkpoint check-in (checkpointId set) or an ad-hoc "shoot a picture of this" report
// (checkpointId null) submitted by the guard from the public duty portal.
enum PatrolObservationCategory {
  SAFETY_HAZARD
  SUSPICIOUS_ACTIVITY
  SECURITY_CONCERN
  MAINTENANCE_ISSUE
  GENERAL_OBSERVATION
  OTHER
}

// A guard's observation, whether logged at a checkpoint during a scheduled patrol
// (assignmentId set) or standalone while simply on duty with no assignment for the day
// (assignmentId null — siteId/workerId carry attribution instead). Photo is optional so a
// guard can log a text-only observation; category classifies standalone observations for
// supervisor triage (checkpoint scans leave it unset).
model PatrolLogEntry {
  id            String                     @id @default(cuid())
  assignmentId  String?
  assignment    PatrolAssignment?          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  checkpointId  String?
  checkpoint    PatrolCheckpoint?          @relation(fields: [checkpointId], references: [id], onDelete: SetNull)
  siteId        String?
  site          Site?                      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workerId      String?
  worker        Worker?                    @relation(fields: [workerId], references: [id], onDelete: SetNull)
  category      PatrolObservationCategory?
  photoData     Bytes?
  photoMimeType String?
  notes         String?
  latitude      Float?
  longitude     Float?
  loggedAt      DateTime                   @default(now())
}

model CodeOfPractice {
  id            String      @id @default(cuid())
  title         String
  category      CopCategory
  version       String
  status        CopStatus   @default(DRAFT)
  effectiveDate DateTime
  reviewDate    DateTime
  approvedBy    String?
  description   String?
  siteId        String
  site          Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId        String?
  zone          Zone?       @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model RiskAssessment {
  id                String               @id @default(cuid())
