generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
  VIEWER
  EXECUTIVE
}

enum ExecutiveTitle {
  GENERAL_MANAGER
  CFO
  COO
  HR_MANAGER
  SECURITY_MANAGER
  SAFETY_MANAGER
  OPERATIONS_MANAGER
  COMPLIANCE_OFFICER
  IT_MANAGER
  OTHER
}

enum ExecReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SiteStatus {
  OPERATIONAL
  RESTRICTED
  SHUT_DOWN
}

enum SensorType {
  METHANE
  CARBON_MONOXIDE
  OXYGEN
  TEMPERATURE
  HUMIDITY
  SEISMIC
  AIR_FLOW
}

enum SensorStatus {
  ACTIVE
  INACTIVE
  FAULT
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum WorkerStatus {
  ON_SHIFT
  OFF_SHIFT
  EMERGENCY
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

enum EquipmentStatus {
  OPERATIONAL
  MAINTENANCE
  DOWN
}

enum CopCategory {
  ROCK_ENGINEERING
  VENTILATION
  EXPLOSIVES
  FALL_OF_GROUND
  TRACKLESS_MOBILE_MACHINERY
  WINDING_PLANT
  ELECTRICAL
  OCCUPATIONAL_HEALTH
  EMERGENCY_PREPAREDNESS
  OTHER
}

enum CopStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  EXPIRED
  WITHDRAWN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskAssessmentStatus {
  DRAFT
  APPROVED
  UNDER_REVIEW
  EXPIRED
}

enum RiskMitigationStatus {
  OPEN
  IN_PROGRESS
  MITIGATED
  ACCEPTED
}

enum NoticeSection {
  SECTION_54
  SECTION_55
  SECTION_53
  OTHER
}

enum NoticeStatus {
  OPEN
  COMPLIED
  WITHDRAWN
  APPEALED
}

enum ExamType {
  PRE_EMPLOYMENT
  PERIODICAL
  EXIT
  RETURN_TO_WORK
}

enum FitnessResult {
  FIT
  FIT_WITH_RESTRICTION
  TEMPORARILY_UNFIT
  UNFIT
}

enum InspectionStatus {
  SCHEDULED
  COMPLETED
  OVERDUE
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String
  role         Role            @default(VIEWER)
  title        ExecutiveTitle?
  photoData    Bytes?
  photoMimeType String?
  createdAt    DateTime        @default(now())

  mineId String?
  mine   Mine?   @relation(fields: [mineId], references: [id], onDelete: SetNull)

  acknowledgedAlerts Alert[]    @relation("AlertAcknowledgedBy")
  reportedIncidents  Incident[] @relation("IncidentReportedBy")
  reviewedAlerts     Alert[]    @relation("AlertReviewedBy")
  reviewedIncidents  Incident[] @relation("IncidentReviewedBy")
  uploadedDocuments  Document[]

  siteAssignments        ExecutiveSiteAssignment[]
  ptwSupervisorDecisions PermitToWork[]             @relation("PtwSupervisorDecision")
  ptwExecutiveDecisions  PermitToWork[]             @relation("PtwExecutiveDecision")
  createdInvites         ExecutiveInvite[]          @relation("InviteCreatedBy")
  acceptedInvite         ExecutiveInvite?           @relation("InviteAcceptedUser")
  loggedDeliveries       Delivery[]
  sentMessages           Message[]                  @relation("MessageSender")
  receivedMessages       Message[]                  @relation("MessageRecipient")
  reviewedBuyers         Buyer[]
  listedMinerals         MineralListing[]
  postedContracts        ContractOpportunity[]
  productionRecords      ProductionRecord[]     @relation("ProductionRecordedBy")
  maintenanceSchedules   MaintenanceSchedule[]  @relation("MaintenanceCreatedBy")
  fleetPositions         FleetPosition[]        @relation("FleetPositionRecordedBy")
  inventoryMovements     InventoryMovement[]    @relation("InventoryMovementBy")
  weatherReadings        WeatherReading[]       @relation("WeatherRecordedBy")
  safetyObservations     SafetyObservation[]    @relation("SafetyObservationReportedBy")
  explosivesTransactions ExplosivesTransaction[] @relation("ExplosivesAuthorizedBy")
  environmentalReadings  EnvironmentalReading[]  @relation("EnvironmentalRecordedBy")
  evacuationDrills       EvacuationDrill[]       @relation("DrillConductedBy")
  shiftRosters           ShiftRoster[]           @relation("RosterCreatedBy")
  leaveApprovals         LeaveRequest[]          @relation("LeaveApprovedBy")
  payslipsUploaded       Payslip[]               @relation("PayslipUploadedBy")
  poRequests             PurchaseOrder[]         @relation("PORequestedBy")
  poApprovals            PurchaseOrder[]         @relation("POApprovedBy")
  invoicesCreated        Invoice[]               @relation("InvoiceCreatedBy")
  payeesCreated          Payee[]                 @relation("PayeeCreatedBy")
  expensesCreated        Expense[]               @relation("ExpenseCreatedBy")
  evacuationsTriggered   EmergencyEvacuation[]   @relation("EvacuationTriggeredBy")
  evacuationsCancelled   EmergencyEvacuation[]   @relation("EvacuationCancelledBy")
}

model Site {
  id          String     @id @default(cuid())
  name        String
  location    String
  description String?
  status      SiteStatus @default(OPERATIONAL)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  mineId String
  mine   Mine   @relation(fields: [mineId], references: [id], onDelete: Cascade)

  zones     Zone[]
  workers   Worker[]
  incidents Incident[]
  equipment Equipment[]
  alerts    Alert[]

  codesOfPractice   CodeOfPractice[]
  riskAssessments   RiskAssessment[]
  regulatoryNotices RegulatoryNotice[]
  safetyInspections SafetyInspection[]
  permits           Permit[]
  documents         Document[]
  inspectionVisits  InspectionVisit[]
  contractors       Contractor[]

  executiveAssignments ExecutiveSiteAssignment[]
  visitors             Visitor[]
  permitsToWork        PermitToWork[]
  deliveries           Delivery[]
  mineralListings      MineralListing[]
  contractOpportunities ContractOpportunity[]
  productionRecords    ProductionRecord[]
  fleetPositions       FleetPosition[]
  inventoryItems       InventoryItem[]
  weatherReadings      WeatherReading[]
  safetyObservations   SafetyObservation[]
  explosivesMagazines  ExplosivesMagazine[]
  environmentalReadings EnvironmentalReading[]
  emergencyContacts    EmergencyContact[]
  evacuationDrills     EvacuationDrill[]
  shiftRosters         ShiftRoster[]
  trainingCourses      TrainingCourse[]
  purchaseOrders       PurchaseOrder[]
  invoices             Invoice[]
  expenses             Expense[]
  evacuations          EmergencyEvacuation[]
}

model Zone {
  id          String  @id @default(cuid())
  name        String
  description String?
  siteId      String
  site        Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  sensors   Sensor[]
  workers   Worker[]
  incidents Incident[]
  equipment Equipment[]
  alerts    Alert[]

  codesOfPractice   CodeOfPractice[]
  riskAssessments   RiskAssessment[]
  regulatoryNotices RegulatoryNotice[]
  safetyInspections SafetyInspection[]
  productionRecords ProductionRecord[]
  safetyObservations SafetyObservation[]

  createdAt DateTime @default(now())
}

model Sensor {
  id       String       @id @default(cuid())
  name     String
  type     SensorType
  unit     String
  minSafe  Float
  maxSafe  Float
  status   SensorStatus @default(ACTIVE)
  zoneId   String
  zone     Zone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  readings SensorReading[]
  alerts   Alert[]

  createdAt DateTime @default(now())
}

model SensorReading {
  id         String   @id @default(cuid())
  sensorId   String
  sensor     Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  value      Float
  recordedAt DateTime @default(now())

  @@index([sensorId, recordedAt])
}

model Alert {
  id             String        @id @default(cuid())
  siteId         String
  site           Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId         String?
  zone           Zone?         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  sensorId       String?
  sensor         Sensor?       @relation(fields: [sensorId], references: [id], onDelete: SetNull)
  severity       AlertSeverity
  message        String
  status         AlertStatus   @default(OPEN)
  createdAt      DateTime      @default(now())
  acknowledgedAt DateTime?
  acknowledgedById String?
  acknowledgedBy   User?       @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?

  reviewStatus ExecReviewStatus @default(PENDING)
  reviewNote   String?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?            @relation("AlertReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
}

enum StaffCategory {
  MINING_OPERATIONS
  ENGINEERING_TECHNICAL
  DRIVER
  CLEANER
  SECURITY
  ADMINISTRATION
  EXECUTIVE
  MEDICAL
  SAFETY_HEALTH
  MAINTENANCE
  CATERING
  OTHER
}

model Worker {
  id            String        @id @default(cuid())
  name          String
  employeeId    String        @unique
  role          String
  category      StaffCategory @default(OTHER)
  phone         String?
  status        WorkerStatus @default(OFF_SHIFT)
  photoData     Bytes?
  photoMimeType String?
  siteId        String
  site          Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId        String?
  zone          Zone?        @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  nextOfKinName         String?
  nextOfKinRelationship String?
  nextOfKinPhone        String?

  medicalRecords  MedicalSurveillance[]
  certificates    Certificate[]
  trainingRecords TrainingRecord[]
  attendance      WorkerAttendance[]
  rosterAssignments   RosterAssignment[]
  trainingEnrollments TrainingEnrollment[]
  leaveRequests   LeaveRequest[]
  payslips        Payslip[]

  createdAt DateTime @default(now())
}

model WorkerAttendance {
  id         String    @id @default(cuid())
  workerId   String
  worker     Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  checkInAt  DateTime  @default(now())
  checkOutAt DateTime?

  createdAt DateTime @default(now())
}

model Incident {
  id           String         @id @default(cuid())
  title        String
  description  String
  severity     AlertSeverity
  status       IncidentStatus @default(OPEN)
  siteId       String
  site         Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId       String?
  zone         Zone?          @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  reportedById String?
  reportedBy   User?          @relation("IncidentReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)

  reviewStatus ExecReviewStatus @default(PENDING)
  reviewNote   String?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?            @relation("IncidentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model Equipment {
  id              String          @id @default(cuid())
  name            String
  type            String
  status          EquipmentStatus @default(OPERATIONAL)
  siteId          String
  site            Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId          String?
  zone            Zone?           @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  lastMaintenance DateTime?

  maintenanceSchedules MaintenanceSchedule[]

  createdAt DateTime @default(now())
}

model CodeOfPractice {
  id            String      @id @default(cuid())
  title         String
  category      CopCategory
  version       String
  status        CopStatus   @default(DRAFT)
  effectiveDate DateTime
  reviewDate    DateTime
  approvedBy    String?
  description   String?
  siteId        String
  site          Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId        String?
  zone          Zone?       @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model RiskAssessment {
  id                String               @id @default(cuid())
  title             String
  hazard            String
  initialRiskLevel  RiskLevel
  residualRiskLevel RiskLevel
  controlMeasures   String
  assessor          String
  status            RiskAssessmentStatus @default(DRAFT)
  assessmentDate    DateTime
  reviewDate        DateTime
  siteId            String
  site              Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId            String?
  zone              Zone?                @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  likelihood        Int                   @default(3)
  severity          Int                   @default(3)
  owner             String?
  mitigationStatus  RiskMitigationStatus  @default(OPEN)
  mitigationDueDate DateTime?
  escalated         Boolean               @default(false)
  escalatedAt       DateTime?

  createdAt DateTime @default(now())
}

model RegulatoryNotice {
  id                  String         @id @default(cuid())
  noticeNumber        String
  section             NoticeSection
  issuedBy            String
  issuedDate          DateTime
  description         String
  complianceDeadline  DateTime?
  status              NoticeStatus   @default(OPEN)
  compliedDate        DateTime?
  siteId              String
  site                Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId              String?
  zone                Zone?          @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  visits InspectionVisit[]

  createdAt DateTime @default(now())
}

model MedicalSurveillance {
  id            String        @id @default(cuid())
  workerId      String
  worker        Worker        @relation(fields: [workerId], references: [id], onDelete: Cascade)
  examType      ExamType
  examDate      DateTime
  result        FitnessResult
  restrictions  String?
  nextExamDue   DateTime
  practitioner  String

  createdAt DateTime @default(now())
}

model SafetyInspection {
  id               String            @id @default(cuid())
  title            String
  inspectionType   String
  scheduledDate    DateTime
  completedDate    DateTime?
  inspector        String
  findings         String?
  correctiveActions String?
  status           InspectionStatus  @default(SCHEDULED)
  siteId           String
  site             Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId           String?
  zone             Zone?             @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

enum PermitType {
  MINING_RIGHT
  MINING_PERMIT
  PROSPECTING_RIGHT
  WATER_USE_LICENSE
  ENVIRONMENTAL_AUTHORISATION
  SOCIAL_LABOUR_PLAN
  EXPLOSIVES_LICENSE
  MINE_WORKS_PROGRAMME
  OTHER
}

enum PermitStatus {
  ACTIVE
  PENDING_RENEWAL
  EXPIRED
  SUSPENDED
  WITHDRAWN
}

model Permit {
  id               String       @id @default(cuid())
  permitNumber     String
  type             PermitType
  issuingAuthority String
  holderName       String
  issueDate        DateTime
  expiryDate       DateTime
  status           PermitStatus @default(ACTIVE)
  conditions       String?
  siteId           String
  site             Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum CertificateType {
  MINE_MANAGER
  MINE_OVERSEER
  SHIFT_SUPERVISOR
  BLASTING
  ROCK_BREAKER
  WINDING_ENGINE_DRIVER
  ELECTRICAL
  MECHANICAL
  OTHER
}

enum CertificateStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  WITHDRAWN
}

model Certificate {
  id                String            @id @default(cuid())
  workerId          String
  worker            Worker            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  type              CertificateType
  certificateNumber String
  issuingBody       String
  issueDate         DateTime
  expiryDate        DateTime?
  status            CertificateStatus @default(ACTIVE)

  createdAt DateTime @default(now())
}

enum TrainingType {
  INDUCTION
  REFRESHER
  FIRST_AID
  FIRE_FIGHTING
  SELF_RESCUE
  HAZARD_SPECIFIC
  SKILLS_DEVELOPMENT
  OTHER
}

model TrainingRecord {
  id             String       @id @default(cuid())
  workerId       String
  worker         Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  courseName     String
  trainingType   TrainingType
  completionDate DateTime
  expiryDate     DateTime?
  provider       String

  createdAt DateTime @default(now())
}

enum DocumentType {
  POLICY
  CODE_OF_PRACTICE
  PERMIT
  CERTIFICATE
  REPORT
  PROCEDURE
  DRAWING
  CONTRACT
  INVOICE
  EXPENSE_RECEIPT
  OTHER
}

enum DocumentStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  ARCHIVED
  WITHDRAWN
}

model Document {
  id          String         @id @default(cuid())
  title       String
  type        DocumentType
  version     String
  status      DocumentStatus @default(ACTIVE)
  description String?
  reviewDate  DateTime?
  mineId      String
  mine        Mine           @relation(fields: [mineId], references: [id], onDelete: Cascade)
  siteId      String?
  site        Site?          @relation(fields: [siteId], references: [id], onDelete: SetNull)

  fileName     String
  fileMimeType String
  fileSize     Int
  fileData     Bytes

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  invoices Invoice[]
  expenses Expense[]

  createdAt DateTime @default(now())
}

enum InspectionOutcome {
  NO_ACTION
  VERBAL_WARNING
  NOTICE_ISSUED
  FOLLOW_UP_REQUIRED
}

model InspectionVisit {
  id             String            @id @default(cuid())
  visitDate      DateTime
  inspectorName  String
  inspectorBadge String?
  authority      String
  areasInspected String
  purpose        String?
  findings       String?
  outcome        InspectionOutcome @default(NO_ACTION)
  siteId         String
  site           Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)

  relatedNoticeId String?
  relatedNotice   RegulatoryNotice? @relation(fields: [relatedNoticeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model Mine {
  id                 String   @id @default(cuid())
  name               String
  location           String
  registrationNumber String?
  miningRightNumber  String?
  description        String?
  passkeyHash        String
  logoData           Bytes?
  logoMimeType       String?
  logoFileName       String?
  createdAt          DateTime @default(now())

  users            User[]
  executiveInvites ExecutiveInvite[]
  sites            Site[]
  documents        Document[]
  emergencyContacts EmergencyContact[]
  trainingCourses  TrainingCourse[]
  payees           Payee[]
  suppliers        Supplier[]
  evacuations      EmergencyEvacuation[]
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model ExecutiveInvite {
  id             String         @id @default(cuid())
  mineId         String
  mine           Mine           @relation(fields: [mineId], references: [id], onDelete: Cascade)
  name           String
  email          String
  title          ExecutiveTitle @default(OTHER)
  keyHash        String
  status         InviteStatus   @default(PENDING)
  invitedById    String?
  invitedBy      User?        @relation("InviteCreatedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt     DateTime?
  acceptedUserId String?      @unique
  acceptedUser   User?        @relation("InviteAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

enum ContractorStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  TERMINATED
}

model Contractor {
  id                  String           @id @default(cuid())
  companyName         String
  registrationNumber  String?
  scopeOfWork         String
  contactName         String
  contactPhone        String?
  contactEmail        String?
  contractStartDate   DateTime
  contractEndDate     DateTime
  goodStandingExpiry  DateTime?
  insuranceExpiry     DateTime?
  status              ContractorStatus @default(ACTIVE)
  siteId              String
  site                Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)

  permitsToWork PermitToWork[]

  createdAt DateTime @default(now())
}

model ExecutiveSiteAssignment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, siteId])
}

enum VisitorStatus {
  CHECKED_IN
  CHECKED_OUT
  DENIED
}

enum VisitorDocumentType {
  ID_DOCUMENT
  MEDICAL_CERTIFICATE
  INDUCTION_ACKNOWLEDGEMENT
  OTHER
}

model Visitor {
  id                    String        @id @default(cuid())
  fullName              String
  idNumber              String
  company               String?
  contactPhone          String
  contactEmail          String?
  hostName              String
  purposeOfVisit        String
  vehicleRegistration   String?
  siteId                String
  site                  Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  status                VisitorStatus @default(CHECKED_IN)
  checkInAt             DateTime      @default(now())
  checkOutAt            DateTime?
  inductionAcknowledged Boolean       @default(false)
  popiaConsentAccepted  Boolean       @default(false)
  indemnityAccepted     Boolean       @default(false)

  documents VisitorDocument[]

  createdAt DateTime @default(now())
}

model VisitorDocument {
  id           String              @id @default(cuid())
  visitorId    String
  visitor      Visitor             @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  docType      VisitorDocumentType @default(OTHER)
  fileName     String
  fileMimeType String
  fileSize     Int
  fileData     Bytes

  createdAt DateTime @default(now())
}

enum PermitToWorkStatus {
  PENDING_SUPERVISOR
  PENDING_EXECUTIVE
  APPROVED
  REJECTED
  EXPIRED
  CLOSED
}

model PermitToWork {
  id                String             @id @default(cuid())
  contractorId      String
  contractor        Contractor         @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  siteId            String
  site              Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workDescription   String
  workArea          String
  hazardsIdentified String
  controlMeasures   String
  startDate         DateTime
  endDate           DateTime
  requestedByName   String
  status            PermitToWorkStatus @default(PENDING_SUPERVISOR)

  supervisorNote        String?
  supervisorDecidedAt   DateTime?
  supervisorDecidedById String?
  supervisorDecidedBy   User?     @relation("PtwSupervisorDecision", fields: [supervisorDecidedById], references: [id], onDelete: SetNull)

  executiveNote        String?
  executiveDecidedAt   DateTime?
  executiveDecidedById String?
  executiveDecidedBy   User?     @relation("PtwExecutiveDecision", fields: [executiveDecidedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model Truck {
  id                  String   @id @default(cuid())
  registrationNumber  String   @unique
  vehicleType         String?
  driverName          String
  driverLicense       String?
  driverPhone         String?
  haulierCompany      String?
  createdAt           DateTime @default(now())

  deliveries Delivery[]
  fleetPositions FleetPosition[]
}

enum DeliveryDirection {
  INBOUND
  OUTBOUND
}

enum DeliveryStatus {
  CHECKED_IN
  CHECKED_OUT
}

model Delivery {
  id           String            @id @default(cuid())
  truckId      String
  truck        Truck             @relation(fields: [truckId], references: [id], onDelete: Cascade)
  siteId       String
  site         Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  direction    DeliveryDirection
  cargoType    String
  quantity     Float?
  unit         String?
  notes        String?
  status       DeliveryStatus    @default(CHECKED_IN)
  checkInAt    DateTime          @default(now())
  checkOutAt   DateTime?
  loggedById   String?
  loggedBy     User?             @relation(fields: [loggedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model Message {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([senderId, recipientId])
  @@index([recipientId, readAt])
}

enum BuyerType {
  INDIVIDUAL
  COMPANY
  TRUST
  PARTNERSHIP
}

enum BuyerStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

// Buyer registration is deliberately strict / FICA-style: South African law requires
// dealers in minerals, precious metals, and precious stones to identify and vet their
// counterparties (FICA, the Precious Metals Act, and the Diamonds Act) before trading.
model Buyer {
  id                      String      @id @default(cuid())
  buyerType               BuyerType
  legalName               String
  tradingName             String?
  registrationNumber      String?
  idNumber                String?
  taxNumber               String
  vatNumber               String?
  dealerLicenseNumber     String?
  dealerLicenseAuthority  String?
  dealerLicenseExpiry     DateTime?
  physicalAddress         String
  postalAddress           String?
  contactName             String
  contactPhone            String
  contactEmail            String      @unique
  bankName                String?
  bankAccountHolder       String?
  bankAccountNumber       String?
  bankBranchCode          String?
  bbbeeLevel              String?
  sourceOfFunds           String
  popiaConsentAccepted    Boolean     @default(false)
  ficaDeclarationAccepted Boolean     @default(false)
  amlDeclarationAccepted  Boolean     @default(false)
  status                  BuyerStatus @default(PENDING_REVIEW)
  reviewNote              String?
  reviewedAt              DateTime?
  reviewedById            String?
  reviewedBy              User?       @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  documents BuyerDocument[]
  bids      MineralBid[]

  createdAt DateTime @default(now())
}

enum BuyerDocumentType {
  ID_OR_REGISTRATION
  PROOF_OF_ADDRESS
  DEALER_LICENSE
  TAX_CLEARANCE
  OTHER
}

model BuyerDocument {
  id           String            @id @default(cuid())
  buyerId      String
  buyer        Buyer             @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  docType      BuyerDocumentType @default(OTHER)
  fileName     String
  fileMimeType String
  fileSize     Int
  fileData     Bytes

  createdAt DateTime @default(now())
}

enum MineralListingStatus {
  AVAILABLE
  SOLD
  WITHDRAWN
}

model MineralListing {
  id            String               @id @default(cuid())
  siteId        String
  site          Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  mineralType   String
  grade         String?
  quantity      Float
  unit          String
  pricePerUnit  Float?
  currency      String               @default("ZAR")
  description   String?
  packaging     String?
  certifications String?
  status        MineralListingStatus @default(AVAILABLE)
  listedById    String?
  listedBy      User?                @relation(fields: [listedById], references: [id], onDelete: SetNull)

  bids   MineralBid[]
  images MineralListingImage[]

  createdAt DateTime @default(now())
}

model MineralListingImage {
  id           String          @id @default(cuid())
  listingId    String
  listing      MineralListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fileName     String
  fileMimeType String
  fileSize     Int
  fileData     Bytes

  createdAt DateTime @default(now())
}

enum MineralBidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model MineralBid {
  id         String            @id @default(cuid())
  listingId  String
  listing    MineralListing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId    String
  buyer      Buyer             @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  quantity   Float
  offerPrice Float
  notes      String?
  status     MineralBidStatus  @default(PENDING)

  createdAt DateTime @default(now())
}

enum ContractOpportunityStatus {
  OPEN
  CLOSED
  AWARDED
  CANCELLED
}

enum ContractCategory {
  TRUCKING_HAULAGE
  GEOLOGICAL_SERVICES
  DRILLING_BLASTING
  EARTHMOVING_EXCAVATION
  PLANT_EQUIPMENT_MAINTENANCE
  ELECTRICAL_INSTRUMENTATION
  CIVIL_CONSTRUCTION
  ENVIRONMENTAL_REHABILITATION
  SECURITY_SERVICES
  CATERING_ACCOMMODATION
  TRANSPORT_LOGISTICS
  CONSULTING_PROFESSIONAL
  SUPPLY_EQUIPMENT_MATERIALS
  IT_TELECOMMUNICATIONS
  OTHER
}

model ContractOpportunity {
  id                 String                     @id @default(cuid())
  siteId             String
  site               Site                       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  category           ContractCategory           @default(OTHER)
  title              String
  description        String
  scopeOfWork        String
  budgetRange        String?
  submissionDeadline DateTime
  status             ContractOpportunityStatus  @default(OPEN)
  postedById         String?
  postedBy           User?                      @relation(fields: [postedById], references: [id], onDelete: SetNull)

  bids ContractBid[]

  createdAt DateTime @default(now())
}

enum ContractBidStatus {
  SUBMITTED
  SHORTLISTED
  AWARDED
  REJECTED
  WITHDRAWN
}

model ContractBid {
  id            String            @id @default(cuid())
  opportunityId String
  opportunity   ContractOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  companyName   String
  contactName   String
  contactPhone  String
  contactEmail  String
  bidAmount     Float
  proposalNotes String?
  status        ContractBidStatus @default(SUBMITTED)

  createdAt DateTime @default(now())
}

enum ProductionShift {
  DAY
  AFTERNOON
  NIGHT
}

model ProductionRecord {
  id            String          @id @default(cuid())
  siteId        String
  site          Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId        String?
  zone          Zone?           @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  shiftDate     DateTime
  shift         ProductionShift
  mineralType   String
  tonnesMined   Float
  oreGrade      Float?
  wasteRemoved  Float?
  targetTonnes  Float?
  notes         String?
  recordedById  String?
  recordedBy    User?           @relation("ProductionRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
}

enum MaintenanceScheduleStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

model MaintenanceSchedule {
  id              String                     @id @default(cuid())
  equipmentId     String
  equipment       Equipment                  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  maintenanceType MaintenanceType
  scheduledDate   DateTime
  completedDate   DateTime?
  performedBy     String?
  status          MaintenanceScheduleStatus  @default(SCHEDULED)
  findings        String?
  partsUsed       String?
  cost            Float?
  createdById     String?
  createdBy       User?                      @relation("MaintenanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model FleetPosition {
  id           String   @id @default(cuid())
  truckId      String
  truck        Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  latitude     Float
  longitude    Float
  speedKmh     Float?
  heading      Float?
  recordedById String?
  recordedBy   User?    @relation("FleetPositionRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

enum InventoryMovementDirection {
  IN
  OUT
}

model InventoryItem {
  id             String   @id @default(cuid())
  siteId         String
  site           Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  partNumber     String?
  name           String
  category       String?
  quantityOnHand Float    @default(0)
  reorderPoint   Float?
  unit           String
  unitCost       Float?
  supplier       String?
  location       String?

  movements InventoryMovement[]

  createdAt DateTime @default(now())
}

model InventoryMovement {
  id            String                      @id @default(cuid())
  itemId        String
  item          InventoryItem               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  direction     InventoryMovementDirection
  quantity      Float
  reason        String?
  performedById String?
  performedBy   User?                       @relation("InventoryMovementBy", fields: [performedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

enum WeatherCondition {
  CLEAR
  CLOUDY
  RAIN
  STORM
  FOG
  HIGH_WIND
}

model WeatherReading {
  id                String           @id @default(cuid())
  siteId            String
  site              Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  recordedAt        DateTime         @default(now())
  temperature       Float?
  windSpeed         Float?
  windDirection     String?
  precipitation     Float?
  condition         WeatherCondition @default(CLEAR)
  lightningDetected Boolean          @default(false)
  alertIssued       Boolean          @default(false)
  notes             String?
  recordedById      String?
  recordedBy        User?            @relation("WeatherRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

enum SafetyObservationType {
  NEAR_MISS
  UNSAFE_ACT
  UNSAFE_CONDITION
  POSITIVE_OBSERVATION
}

enum SafetyObservationStatus {
  OPEN
  ACTION_REQUIRED
  CLOSED
}

model SafetyObservation {
  id           String                  @id @default(cuid())
  siteId       String
  site         Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId       String?
  zone         Zone?                   @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  type         SafetyObservationType
  severity     AlertSeverity           @default(LOW)
  description  String
  location     String?
  actionTaken  String?
  status       SafetyObservationStatus @default(OPEN)
  reporterName String?
  reportedById String?
  reportedBy   User?                   @relation("SafetyObservationReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  closedAt     DateTime?

  createdAt DateTime @default(now())
}

enum ExplosivesMagazineStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

model ExplosivesMagazine {
  id                 String                    @id @default(cuid())
  siteId             String
  site               Site                      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  magazineNumber     String
  licenseNumber      String
  licenseExpiry      DateTime
  capacity           Float
  unit               String
  currentStock       Float                     @default(0)
  lastInspectionDate DateTime?
  nextInspectionDue  DateTime?
  status             ExplosivesMagazineStatus  @default(ACTIVE)

  transactions ExplosivesTransaction[]

  createdAt DateTime @default(now())
}

enum ExplosivesTransactionType {
  RECEIPT
  ISSUE
  RETURN
  DESTRUCTION
}

model ExplosivesTransaction {
  id              String                     @id @default(cuid())
  magazineId      String
  magazine        ExplosivesMagazine         @relation(fields: [magazineId], references: [id], onDelete: Cascade)
  transactionType ExplosivesTransactionType
  explosiveType   String
  quantity        Float
  issuedTo        String?
  authorizedById  String?
  authorizedBy    User?                      @relation("ExplosivesAuthorizedBy", fields: [authorizedById], references: [id], onDelete: SetNull)
  transactionDate DateTime                   @default(now())
  notes           String?

  createdAt DateTime @default(now())
}

enum EnvironmentalParameterType {
  WATER_QUALITY
  AIR_QUALITY
  DUST
  NOISE
  TAILINGS_DAM_LEVEL
}

model EnvironmentalReading {
  id              String                     @id @default(cuid())
  siteId          String
  site            Site                       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  monitoringPoint String
  parameterType   EnvironmentalParameterType
  value           Float
  unit            String
  thresholdMin    Float?
  thresholdMax    Float?
  withinLimits    Boolean                    @default(true)
  notes           String?
  recordedById    String?
  recordedBy      User?                      @relation("EnvironmentalRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedAt      DateTime                   @default(now())

  createdAt DateTime @default(now())
}

enum EmergencyContactCategory {
  MINE_RESCUE
  MEDICAL
  AMBULANCE
  FIRE
  POLICE
  SECURITY
  INTERNAL_MANAGEMENT
  OTHER
}

model EmergencyContact {
  id       String                    @id @default(cuid())
  mineId   String
  mine     Mine                      @relation(fields: [mineId], references: [id], onDelete: Cascade)
  siteId   String?
  site     Site?                     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name     String
  role     String
  phone    String
  category EmergencyContactCategory  @default(OTHER)
  priority Int                       @default(0)

  createdAt DateTime @default(now())
}

enum EvacuationDrillType {
  FIRE
  GAS_LEAK
  SEISMIC
  GENERAL
}

model EvacuationDrill {
  id                String              @id @default(cuid())
  siteId            String
  site              Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  drillDate         DateTime
  drillType         EvacuationDrillType
  totalParticipants Int?
  musterTimeSeconds Int?
  issuesIdentified  String?
  conductedById     String?
  conductedBy       User?               @relation("DrillConductedBy", fields: [conductedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

enum EvacuationStatus {
  ACTIVE
  CANCELLED
}

model EmergencyEvacuation {
  id             String           @id @default(cuid())
  mineId         String
  mine           Mine             @relation(fields: [mineId], references: [id], onDelete: Cascade)
  siteId         String
  site           Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assemblyPoint  String
  message        String?
  status         EvacuationStatus @default(ACTIVE)
  triggeredById  String?
  triggeredBy    User?            @relation("EvacuationTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  triggeredAt    DateTime         @default(now())
  cancelledById  String?
  cancelledBy    User?            @relation("EvacuationCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledAt    DateTime?

  createdAt DateTime @default(now())
}

enum ShiftType {
  DAY
  AFTERNOON
  NIGHT
}

model ShiftRoster {
  id          String    @id @default(cuid())
  siteId      String
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  shiftDate   DateTime
  shiftType   ShiftType
  notes       String?
  createdById String?
  createdBy   User?     @relation("RosterCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  assignments RosterAssignment[]

  createdAt DateTime @default(now())

  @@unique([siteId, shiftDate, shiftType])
}

model RosterAssignment {
  id       String      @id @default(cuid())
  rosterId String
  roster   ShiftRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  workerId String
  worker   Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  position String?

  createdAt DateTime @default(now())

  @@unique([rosterId, workerId])
}

model TrainingCourse {
  id            String        @id @default(cuid())
  mineId        String
  mine          Mine          @relation(fields: [mineId], references: [id], onDelete: Cascade)
  siteId        String?
  site          Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  courseName    String
  courseType    TrainingType
  description   String?
  durationHours Float?
  provider      String?

  sessions TrainingSession[]

  createdAt DateTime @default(now())
}

enum TrainingSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model TrainingSession {
  id            String                 @id @default(cuid())
  courseId      String
  course        TrainingCourse         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scheduledDate DateTime
  location      String?
  instructor    String?
  capacity      Int?
  status        TrainingSessionStatus  @default(SCHEDULED)

  enrollments TrainingEnrollment[]

  createdAt DateTime @default(now())
}

enum TrainingAttendanceStatus {
  ENROLLED
  ATTENDED
  NO_SHOW
  COMPLETED
}

model TrainingEnrollment {
  id               String                    @id @default(cuid())
  sessionId        String
  session          TrainingSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workerId         String
  worker           Worker                    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  attendanceStatus TrainingAttendanceStatus  @default(ENROLLED)
  completionDate   DateTime?

  createdAt DateTime @default(now())

  @@unique([sessionId, workerId])
}

enum LeaveType {
  ANNUAL
  SICK
  FAMILY_RESPONSIBILITY
  UNPAID
  STUDY
  MATERNITY_PATERNITY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id            String      @id @default(cuid())
  workerId      String
  worker        Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  leaveType     LeaveType
  startDate     DateTime
  endDate       DateTime
  daysRequested Float
  reason        String?
  status        LeaveStatus @default(PENDING)
  approvedById  String?
  approvedBy    User?       @relation("LeaveApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?

  createdAt DateTime @default(now())
}

model Payslip {
  id             String   @id @default(cuid())
  workerId       String
  worker         Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  payPeriodStart DateTime
  payPeriodEnd   DateTime
  grossPay       Float
  deductions     Float
  netPay         Float
  issuedAt       DateTime @default(now())
  fileName       String?
  fileMimeType   String?
  fileSize       Int?
  fileData       Bytes?
  uploadedById   String?
  uploadedBy     User?    @relation("PayslipUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

model Supplier {
  id                 String         @id @default(cuid())
  mineId             String
  mine               Mine           @relation(fields: [mineId], references: [id], onDelete: Cascade)
  name               String
  registrationNumber String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  category           String?
  bbbeeLevel         String?
  status             SupplierStatus @default(ACTIVE)

  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  siteId               String
  site                 Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  orderNumber          String
  description          String
  totalAmount          Float
  currency             String              @default("ZAR")
  status               PurchaseOrderStatus @default(DRAFT)
  requestedById        String?
  requestedBy          User?               @relation("PORequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById         String?
  approvedBy           User?               @relation("POApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt           DateTime?
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?

  lines PurchaseOrderLine[]

  createdAt DateTime @default(now())
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  orderId         String
  order           PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemDescription String
  quantity        Float
  unitPrice       Float
  lineTotal       Float

  createdAt DateTime @default(now())
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id              String        @id @default(cuid())
  siteId          String
  site            Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  invoiceNumber   String
  clientName      String
  clientAddress   String?
  clientEmail     String?
  clientTaxNumber String?
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  currency        String        @default("ZAR")
  vatRate         Float         @default(15)
  notes           String?
  status          InvoiceStatus @default(DRAFT)
  createdById     String?
  createdBy       User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  documentId      String?
  document        Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)

  lines InvoiceLine[]

  createdAt DateTime @default(now())
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unitPrice   Float
  lineTotal   Float

  createdAt DateTime @default(now())
}

enum PayeeType {
  COMPANY
  INDIVIDUAL
  BUYER
  CONTRACTOR
}

model Payee {
  id                 String    @id @default(cuid())
  mineId             String
  mine               Mine      @relation(fields: [mineId], references: [id], onDelete: Cascade)
  payeeType          PayeeType @default(COMPANY)
  name               String
  registrationNumber String?
  taxNumber          String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  bankName           String?
  bankAccountHolder  String?
  bankAccountNumber  String?
  bankBranchCode     String?
  notes              String?
  createdById        String?
  createdBy          User?     @relation("PayeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  expenses Expense[]

  createdAt DateTime @default(now())
}

enum ExpenseCategory {
  OPERATIONS
  MAINTENANCE
  SALARIES_WAGES
  TRANSPORT_LOGISTICS
  UTILITIES
  PROFESSIONAL_SERVICES
  EQUIPMENT_SUPPLIES
  RENT_LEASE
  INSURANCE
  TAXES_LEVIES
  OTHER
}

enum ExpenseStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  EFT
  CASH
  CHEQUE
  CARD
  OTHER
}

model Expense {
  id             String          @id @default(cuid())
  siteId         String
  site           Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  payeeId        String
  payee          Payee           @relation(fields: [payeeId], references: [id], onDelete: Restrict)
  expenseNumber  String
  category       ExpenseCategory @default(OTHER)
  description    String
  amount         Float
  currency       String          @default("ZAR")
  expenseDate    DateTime        @default(now())
  paymentMethod  PaymentMethod   @default(EFT)
  status         ExpenseStatus   @default(PAID)
  referenceNumber String?
  notes          String?
  documentId     String?
  document       Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?           @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}
