// ---------------------------------------------------------------------------
// Enterprise infrastructure: audit trail
// ---------------------------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// Automatically populated by a Prisma Client Extension (server/src/lib/auditLog.ts) for a
// curated set of compliance/security/HR-critical models — not a blanket log of every table
// (high-volume telemetry like SensorReading would drown out anything meaningful). `snapshot`
// is the record's state as returned by the operation (post-write for create/update, the
// removed row itself for delete), so history is reconstructable without needing true
// before/after diffing.
model AuditLog {
  id          String      @id @default(cuid())
  mineId      String?
  entityType  String
  entityId    String
  action      AuditAction
  changedById String?
  changedBy   User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)
  snapshot    Json?
  createdAt   DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([mineId, createdAt])
}

// ---------------------------------------------------------------------------
// Mining Intelligence Engine: AI-generated recommendations, tracked to closure
// ---------------------------------------------------------------------------

// The AI's Risk Detector / Predictor / Advisor pipeline stages surface one row
// each per flagged item — never a direct write to any operational model. A row
// only ever changes status (OPEN -> ACKNOWLEDGED/ACTIONED/DISMISSED) via a human
// acting through the review endpoint; the AI can create rows but can never
// change their status itself. This makes "AI recommends, human decides" a
// structural guarantee rather than just a prompt instruction.
enum AiRecommendationKind {
  RISK
  PREDICTION
  RECOMMENDATION
  ACHIEVEMENT
  ANNOUNCEMENT
}

enum AiRecommendationStatus {
  OPEN
  ACKNOWLEDGED
  ACTIONED
  DISMISSED
}

// Which in-app section a recommendation is actually about, so the client can render a
// "Take Action" button that navigates straight to where the underlying record lives (e.g.
// a certificate-expiry risk links to Workforce > Certificates) instead of leaving the
// executive to go find it themselves. Assigned by the AI pipeline from this fixed
// vocabulary — not free text — so the client-side route mapping is exhaustive and reliable.
enum AiRecommendationTopic {
  WORKFORCE_CERTIFICATES
  WORKFORCE_TRAINING
  WORKFORCE_LEAVE
  LABOUR_RELATIONS
  HAZARD_REPORTS
  AUDIT_FINDINGS
  LEGAL_COMPLIANCE
  RISK_ASSESSMENTS
  SAFETY_INSPECTIONS
  MEDICAL_SURVEILLANCE
  STATUTORY_APPOINTMENTS
  IOD_CLAIMS
  TAILINGS
  CLOSURE_REHABILITATION
  EXPLOSIVES
  REGULATORY_NOTICES
  PERMITS
  PERMITS_TO_WORK
  CONTRACTORS
  SECURITY_INCIDENTS
  CCTV
  PATROLS
  VISITORS
  EXPENSES
  PAYEES
  INVOICES
  PURCHASE_ORDERS
  SUPPLIERS
  PAYROLL
  MAINTENANCE
  EQUIPMENT
  PRODUCTION
  SENSORS
  ENVIRONMENT
  EMERGENCY_PREPAREDNESS
  GROUND_CONTROL
  VENTILATION
  MINE_RESCUE
  USER_ACCOUNTS
  GENERAL
}

model AiRecommendation {
  id             String                  @id @default(cuid())
  mineId         String
  executiveTitle ExecutiveTitle
  kind           AiRecommendationKind
  severity       AlertSeverity
  title          String
  detail         String
  topic          AiRecommendationTopic?
  status         AiRecommendationStatus  @default(OPEN)
  reviewedById   String?
  reviewedBy     User?                   @relation("AiRecommendationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  reviewNote     String?
  generatedAt    DateTime                @default(now())

  @@index([mineId, executiveTitle, status])
}

// Proactive, cross-department digest — generated at most once per calendar day (per
// mine) and cached here, unlike everything else in the AI system which recomputes on
// every page load. briefingDate is stored at UTC midnight so the unique constraint
// naturally enforces "one briefing per mine per day".
model AiDailyBriefing {
  id           String   @id @default(cuid())
  mineId       String
  mine         Mine     @relation(fields: [mineId], references: [id], onDelete: Cascade)
  briefingDate DateTime
  headline     String
  topPriority  String?
  sections     Json
  generatedAt  DateTime @default(now())

  @@unique([mineId, briefingDate])
}

