generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
  VIEWER
  EXECUTIVE
}

enum ExecutiveTitle {
  GENERAL_MANAGER
  CFO
  COO
  HR_MANAGER
  SECURITY_MANAGER
  SAFETY_MANAGER
  OPERATIONS_MANAGER
  COMPLIANCE_OFFICER
  IT_MANAGER
  OTHER
}

enum ExecReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SiteStatus {
  OPERATIONAL
  RESTRICTED
  SHUT_DOWN
}

enum SensorType {
  METHANE
  CARBON_MONOXIDE
  OXYGEN
  TEMPERATURE
  HUMIDITY
  SEISMIC
  AIR_FLOW
}

enum SensorStatus {
  ACTIVE
  INACTIVE
  FAULT
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum WorkerStatus {
  ON_SHIFT
  OFF_SHIFT
  EMERGENCY
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

enum EquipmentStatus {
  OPERATIONAL
  MAINTENANCE
  DOWN
}

enum CopCategory {
  ROCK_ENGINEERING
  VENTILATION
  EXPLOSIVES
  FALL_OF_GROUND
  TRACKLESS_MOBILE_MACHINERY
  WINDING_PLANT
  ELECTRICAL
  OCCUPATIONAL_HEALTH
  EMERGENCY_PREPAREDNESS
  OTHER
}

enum CopStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  EXPIRED
  WITHDRAWN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskAssessmentStatus {
  DRAFT
  APPROVED
  UNDER_REVIEW
  EXPIRED
}

enum RiskMitigationStatus {
  OPEN
  IN_PROGRESS
  MITIGATED
  ACCEPTED
}

enum NoticeSection {
  SECTION_54
  SECTION_55
  SECTION_53
  OTHER
}

enum NoticeStatus {
  OPEN
  COMPLIED
  WITHDRAWN
  APPEALED
}

enum ExamType {
  PRE_EMPLOYMENT
  PERIODICAL
  EXIT
  RETURN_TO_WORK
}

enum FitnessResult {
  FIT
  FIT_WITH_RESTRICTION
  TEMPORARILY_UNFIT
  UNFIT
}

enum InspectionStatus {
  SCHEDULED
  COMPLETED
  OVERDUE
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String
  role         Role            @default(VIEWER)
  title        ExecutiveTitle?
  createdAt    DateTime        @default(now())

  mineId String?
  mine   Mine?   @relation(fields: [mineId], references: [id], onDelete: SetNull)

  acknowledgedAlerts Alert[]    @relation("AlertAcknowledgedBy")
  reportedIncidents  Incident[] @relation("IncidentReportedBy")
  reviewedAlerts     Alert[]    @relation("AlertReviewedBy")
  reviewedIncidents  Incident[] @relation("IncidentReviewedBy")
  uploadedDocuments  Document[]

  siteAssignments        ExecutiveSiteAssignment[]
  ptwSupervisorDecisions PermitToWork[]             @relation("PtwSupervisorDecision")
  ptwExecutiveDecisions  PermitToWork[]             @relation("PtwExecutiveDecision")
  createdInvites         ExecutiveInvite[]          @relation("InviteCreatedBy")
  acceptedInvite         ExecutiveInvite?           @relation("InviteAcceptedUser")
}

model Site {
  id          String     @id @default(cuid())
  name        String
  location    String
  description String?
  status      SiteStatus @default(OPERATIONAL)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  zones     Zone[]
  workers   Worker[]
  incidents Incident[]
  equipment Equipment[]
  alerts    Alert[]

  codesOfPractice   CodeOfPractice[]
  riskAssessments   RiskAssessment[]
  regulatoryNotices RegulatoryNotice[]
  safetyInspections SafetyInspection[]
  permits           Permit[]
  documents         Document[]
  inspectionVisits  InspectionVisit[]
  contractors       Contractor[]

  executiveAssignments ExecutiveSiteAssignment[]
  visitors             Visitor[]
  permitsToWork        PermitToWork[]
}

model Zone {
  id          String  @id @default(cuid())
  name        String
  description String?
  siteId      String
  site        Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  sensors   Sensor[]
  workers   Worker[]
  incidents Incident[]
  equipment Equipment[]
  alerts    Alert[]

  codesOfPractice   CodeOfPractice[]
  riskAssessments   RiskAssessment[]
  regulatoryNotices RegulatoryNotice[]
  safetyInspections SafetyInspection[]

  createdAt DateTime @default(now())
}

model Sensor {
  id       String       @id @default(cuid())
  name     String
  type     SensorType
  unit     String
  minSafe  Float
  maxSafe  Float
  status   SensorStatus @default(ACTIVE)
  zoneId   String
  zone     Zone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  readings SensorReading[]
  alerts   Alert[]

  createdAt DateTime @default(now())
}

model SensorReading {
  id         String   @id @default(cuid())
  sensorId   String
  sensor     Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  value      Float
  recordedAt DateTime @default(now())

  @@index([sensorId, recordedAt])
}

model Alert {
  id             String        @id @default(cuid())
  siteId         String
  site           Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId         String?
  zone           Zone?         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  sensorId       String?
  sensor         Sensor?       @relation(fields: [sensorId], references: [id], onDelete: SetNull)
  severity       AlertSeverity
  message        String
  status         AlertStatus   @default(OPEN)
  createdAt      DateTime      @default(now())
  acknowledgedAt DateTime?
  acknowledgedById String?
  acknowledgedBy   User?       @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?

  reviewStatus ExecReviewStatus @default(PENDING)
  reviewNote   String?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?            @relation("AlertReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
}

model Worker {
  id         String       @id @default(cuid())
  name       String
  employeeId String       @unique
  role       String
  phone      String?
  status     WorkerStatus @default(OFF_SHIFT)
  siteId     String
  site       Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId     String?
  zone       Zone?        @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  nextOfKinName         String?
  nextOfKinRelationship String?
  nextOfKinPhone        String?

  medicalRecords  MedicalSurveillance[]
  certificates    Certificate[]
  trainingRecords TrainingRecord[]

  createdAt DateTime @default(now())
}

model Incident {
  id           String         @id @default(cuid())
  title        String
  description  String
  severity     AlertSeverity
  status       IncidentStatus @default(OPEN)
  siteId       String
  site         Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId       String?
  zone         Zone?          @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  reportedById String?
  reportedBy   User?          @relation("IncidentReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)

  reviewStatus ExecReviewStatus @default(PENDING)
  reviewNote   String?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?            @relation("IncidentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model Equipment {
  id              String          @id @default(cuid())
  name            String
  type            String
  status          EquipmentStatus @default(OPERATIONAL)
  siteId          String
  site            Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId          String?
  zone            Zone?           @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  lastMaintenance DateTime?

  createdAt DateTime @default(now())
}

model CodeOfPractice {
  id            String      @id @default(cuid())
  title         String
  category      CopCategory
  version       String
  status        CopStatus   @default(DRAFT)
  effectiveDate DateTime
  reviewDate    DateTime
  approvedBy    String?
  description   String?
  siteId        String
  site          Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId        String?
  zone          Zone?       @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model RiskAssessment {
  id                String               @id @default(cuid())
  title             String
  hazard            String
  initialRiskLevel  RiskLevel
  residualRiskLevel RiskLevel
  controlMeasures   String
  assessor          String
  status            RiskAssessmentStatus @default(DRAFT)
  assessmentDate    DateTime
  reviewDate        DateTime
  siteId            String
  site              Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId            String?
  zone              Zone?                @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  likelihood        Int                   @default(3)
  severity          Int                   @default(3)
  owner             String?
  mitigationStatus  RiskMitigationStatus  @default(OPEN)
  mitigationDueDate DateTime?
  escalated         Boolean               @default(false)
  escalatedAt       DateTime?

  createdAt DateTime @default(now())
}

model RegulatoryNotice {
  id                  String         @id @default(cuid())
  noticeNumber        String
  section             NoticeSection
  issuedBy            String
  issuedDate          DateTime
  description         String
  complianceDeadline  DateTime?
  status              NoticeStatus   @default(OPEN)
  compliedDate        DateTime?
  siteId              String
  site                Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId              String?
  zone                Zone?          @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  visits InspectionVisit[]

  createdAt DateTime @default(now())
}

model MedicalSurveillance {
  id            String        @id @default(cuid())
  workerId      String
  worker        Worker        @relation(fields: [workerId], references: [id], onDelete: Cascade)
  examType      ExamType
  examDate      DateTime
  result        FitnessResult
  restrictions  String?
  nextExamDue   DateTime
  practitioner  String

  createdAt DateTime @default(now())
}

model SafetyInspection {
  id               String            @id @default(cuid())
  title            String
  inspectionType   String
  scheduledDate    DateTime
  completedDate    DateTime?
  inspector        String
  findings         String?
  correctiveActions String?
  status           InspectionStatus  @default(SCHEDULED)
  siteId           String
  site             Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId           String?
  zone             Zone?             @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

enum PermitType {
  MINING_RIGHT
  MINING_PERMIT
  PROSPECTING_RIGHT
  WATER_USE_LICENSE
  ENVIRONMENTAL_AUTHORISATION
  SOCIAL_LABOUR_PLAN
  EXPLOSIVES_LICENSE
  MINE_WORKS_PROGRAMME
  OTHER
}

enum PermitStatus {
  ACTIVE
  PENDING_RENEWAL
  EXPIRED
  SUSPENDED
  WITHDRAWN
}

model Permit {
  id               String       @id @default(cuid())
  permitNumber     String
  type             PermitType
  issuingAuthority String
  holderName       String
  issueDate        DateTime
  expiryDate       DateTime
  status           PermitStatus @default(ACTIVE)
  conditions       String?
  siteId           String
  site             Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum CertificateType {
  MINE_MANAGER
  MINE_OVERSEER
  SHIFT_SUPERVISOR
  BLASTING
  ROCK_BREAKER
  WINDING_ENGINE_DRIVER
  ELECTRICAL
  MECHANICAL
  OTHER
}

enum CertificateStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  WITHDRAWN
}

model Certificate {
  id                String            @id @default(cuid())
  workerId          String
  worker            Worker            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  type              CertificateType
  certificateNumber String
  issuingBody       String
  issueDate         DateTime
  expiryDate        DateTime?
  status            CertificateStatus @default(ACTIVE)

  createdAt DateTime @default(now())
}

enum TrainingType {
  INDUCTION
  REFRESHER
  FIRST_AID
  FIRE_FIGHTING
  SELF_RESCUE
  HAZARD_SPECIFIC
  SKILLS_DEVELOPMENT
  OTHER
}

model TrainingRecord {
  id             String       @id @default(cuid())
  workerId       String
  worker         Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  courseName     String
  trainingType   TrainingType
  completionDate DateTime
  expiryDate     DateTime?
  provider       String

  createdAt DateTime @default(now())
}

enum DocumentType {
  POLICY
  CODE_OF_PRACTICE
  PERMIT
  CERTIFICATE
  REPORT
  PROCEDURE
  DRAWING
  CONTRACT
  OTHER
}

enum DocumentStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  ARCHIVED
  WITHDRAWN
}

model Document {
  id          String         @id @default(cuid())
  title       String
  type        DocumentType
  version     String
  status      DocumentStatus @default(ACTIVE)
  description String?
  reviewDate  DateTime?
  siteId      String?
  site        Site?          @relation(fields: [siteId], references: [id], onDelete: SetNull)

  fileName     String
  fileMimeType String
  fileSize     Int
  fileData     Bytes

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

enum InspectionOutcome {
  NO_ACTION
  VERBAL_WARNING
  NOTICE_ISSUED
  FOLLOW_UP_REQUIRED
}

model InspectionVisit {
  id             String            @id @default(cuid())
  visitDate      DateTime
  inspectorName  String
  inspectorBadge String?
  authority      String
  areasInspected String
  purpose        String?
  findings       String?
  outcome        InspectionOutcome @default(NO_ACTION)
  siteId         String
  site           Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)

  relatedNoticeId String?
  relatedNotice   RegulatoryNotice? @relation(fields: [relatedNoticeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model Mine {
  id                 String   @id @default(cuid())
  name               String
  location           String
  registrationNumber String?
  miningRightNumber  String?
  description        String?
  passkeyHash        String
  logoData           Bytes?
  logoMimeType       String?
  logoFileName       String?
  createdAt          DateTime @default(now())

  users            User[]
  executiveInvites ExecutiveInvite[]
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model ExecutiveInvite {
  id             String         @id @default(cuid())
  mineId         String
  mine           Mine           @relation(fields: [mineId], references: [id], onDelete: Cascade)
  name           String
  email          String
  title          ExecutiveTitle @default(OTHER)
  keyHash        String
  status         InviteStatus   @default(PENDING)
  invitedById    String?
  invitedBy      User?        @relation("InviteCreatedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt     DateTime?
  acceptedUserId String?      @unique
  acceptedUser   User?        @relation("InviteAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

enum ContractorStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  TERMINATED
}

model Contractor {
  id                  String           @id @default(cuid())
  companyName         String
  registrationNumber  String?
  scopeOfWork         String
  contactName         String
  contactPhone        String?
  contactEmail        String?
  contractStartDate   DateTime
  contractEndDate     DateTime
  goodStandingExpiry  DateTime?
  insuranceExpiry     DateTime?
  status              ContractorStatus @default(ACTIVE)
  siteId              String
  site                Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)

  permitsToWork PermitToWork[]

  createdAt DateTime @default(now())
}

model ExecutiveSiteAssignment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, siteId])
}

enum VisitorStatus {
  CHECKED_IN
  CHECKED_OUT
  DENIED
}

enum VisitorDocumentType {
  ID_DOCUMENT
  MEDICAL_CERTIFICATE
  INDUCTION_ACKNOWLEDGEMENT
  OTHER
}

model Visitor {
  id                    String        @id @default(cuid())
  fullName              String
  idNumber              String
  company               String?
  contactPhone          String
  contactEmail          String?
  hostName              String
  purposeOfVisit        String
  vehicleRegistration   String?
  siteId                String
  site                  Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  status                VisitorStatus @default(CHECKED_IN)
  checkInAt             DateTime      @default(now())
  checkOutAt            DateTime?
  inductionAcknowledged Boolean       @default(false)
  popiaConsentAccepted  Boolean       @default(false)
  indemnityAccepted     Boolean       @default(false)

  documents VisitorDocument[]

  createdAt DateTime @default(now())
}

model VisitorDocument {
  id           String              @id @default(cuid())
  visitorId    String
  visitor      Visitor             @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  docType      VisitorDocumentType @default(OTHER)
  fileName     String
  fileMimeType String
  fileSize     Int
  fileData     Bytes

  createdAt DateTime @default(now())
}

enum PermitToWorkStatus {
  PENDING_SUPERVISOR
  PENDING_EXECUTIVE
  APPROVED
  REJECTED
  EXPIRED
  CLOSED
}

model PermitToWork {
  id                String             @id @default(cuid())
  contractorId      String
  contractor        Contractor         @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  siteId            String
  site              Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workDescription   String
  workArea          String
  hazardsIdentified String
  controlMeasures   String
  startDate         DateTime
  endDate           DateTime
  requestedByName   String
  status            PermitToWorkStatus @default(PENDING_SUPERVISOR)

  supervisorNote        String?
  supervisorDecidedAt   DateTime?
  supervisorDecidedById String?
  supervisorDecidedBy   User?     @relation("PtwSupervisorDecision", fields: [supervisorDecidedById], references: [id], onDelete: SetNull)

  executiveNote        String?
  executiveDecidedAt   DateTime?
  executiveDecidedById String?
  executiveDecidedBy   User?     @relation("PtwExecutiveDecision", fields: [executiveDecidedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}
