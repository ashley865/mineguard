  zoneId            String?
  zone              Zone?                @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  likelihood        Int                   @default(3)
  severity          Int                   @default(3)
  owner             String?
  mitigationStatus  RiskMitigationStatus  @default(OPEN)
