  facilityId          String
  facility            TailingsFacility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  inspectionDate      DateTime
  inspector           String
  freeboardMeters     Float?
  seepageObserved     Boolean             @default(false)
  seepageDescription  String?
