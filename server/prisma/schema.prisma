  nextExamDue   DateTime
  practitioner  String

  dustExposed            Boolean                            @default(false)
  lungFunctionResult     String?
  chestXrayResult        String?
  diseaseClassification  OccupationalDiseaseClassification @default(NONE)
  mbodReferenceNumber    String?
  submittedToMbod        Boolean                            @default(false)
  submittedToMbodAt      DateTime?

  createdAt DateTime @default(now())
}

model SafetyInspection {
