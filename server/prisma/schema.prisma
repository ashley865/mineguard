// Point-in-time compliance assessment for a worker, covering the checks HR and the
// Compliance Officer must sign off before a worker may be assigned to a task: training,
// competence, certification, authorisation, medical fitness, task assignment, and currency
// of required training. Kept as an append-only history (like Certificate/TrainingRecord)
// rather than a single mutable record per worker, so past assessments remain auditable.
model EmployeeComplianceCheck {
  id                       String         @id @default(cuid())
  workerId                 String
  worker                   Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  isProperlyTrained        Boolean        @default(false)
  isCompetent              Boolean        @default(false)
  isCertified              Boolean        @default(false)
  isAuthorised             Boolean        @default(false)
  medicalFitness           FitnessResult?
  isAssignedPermittedTasks Boolean        @default(false)
  isTrainingUpToDate       Boolean        @default(false)
  notes                    String?
  assessmentDate           DateTime       @default(now())
  assessedById             String?
  assessedBy               User?          @relation("EmployeeComplianceAssessedBy", fields: [assessedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

