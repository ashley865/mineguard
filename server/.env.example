DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PORT=4000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=https://your-frontend.vercel.app
SIMULATOR_INTERVAL_MS=5000

# AI assistant (optional) — leave AI_API_KEY unset to keep the feature dormant.
# Works with any OpenAI-compatible chat completions endpoint (OpenAI, Groq, OpenRouter, etc).
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Metals price API (optional) — leave unset to keep using the free unofficial Yahoo Finance
# quote source alone. When set, current spot prices come from metals-api.com instead (more
# authoritative), while previousClose/% change still comes from Yahoo — falls back cleanly
# to Yahoo-only if this call fails or the key is invalid/over quota.
METALS_API_KEY=
