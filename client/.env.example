VITE_API_URL=https://your-backend.onrender.com

# Cloudflare Turnstile site key (optional, free, public — safe to expose in client code).
# Leave unset to keep the contractor/buyer registration and tender bid forms working
# exactly as before, with no CAPTCHA widget shown. Pair with TURNSTILE_SECRET_KEY in
# server/.env.example — both must be set for verification to actually happen.
VITE_TURNSTILE_SITE_KEY=
